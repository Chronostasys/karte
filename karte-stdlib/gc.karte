fn gc_init() -> number {
    let heap = runtime_heap_base();
    unsafe_store(heap, heap + 16);
    heap
}

fn gc_alloc(state: number, size: number) -> number {
    let align_mask = 0 - 16;
    let total_size = (size + 16 + 15) bitand align_mask;
    let bump = unsafe_load(state);
    let new_bump = bump + total_size;
    unsafe_store(state, new_bump);
    unsafe_store(bump, 0);
    unsafe_store(bump + 8, total_size);
    bump + 16
}

fn gc_mark(obj: number, heap_base: number, heap_limit: number, state: number) -> number {
    if obj < heap_base {
        0
    } else {
        if obj >= heap_limit {
            0
        } else {
            if obj <= state + 16 {
                0
            } else {
                let header_ptr = obj - 16;
                let header = unsafe_load(header_ptr);
                if header bitand 1 != 0 {
                    0
                } else {
                    unsafe_store(header_ptr, header bitor 1);
                    let size_field = unsafe_load(header_ptr + 8);
                    let data_size = size_field - 16;
                    let i = 0;
                    while i < data_size {
                        let field = unsafe_load(obj + i);
                        if field >= heap_base {
                            if field < heap_limit {
                                if field > state + 16 {
                                    gc_mark(field, heap_base, heap_limit, state)
                                } else {
                                    0
                                }
                            } else {
                                0
                            }
                        } else {
                            0
                        };
                        i = i + 8
                    };
                    0
                }
            }
        }
    }
}

fn gc_sweep(state: number) -> number {
    let heap_base = runtime_heap_base();
    let bump = unsafe_load(state);
    let ptr = heap_base + 16;
    let new_bump = heap_base + 16;
    while ptr < bump {
        let total_size = unsafe_load(ptr + 8);
        if total_size < 16 {
            ptr = bump
        } else {
            let header = unsafe_load(ptr);
            let marked = header bitand 1;
            if marked != 0 {
                unsafe_store(ptr, header bitand (0 - 2));
                new_bump = ptr + total_size;
                ptr = ptr + total_size
            } else {
                ptr = ptr + total_size
            }
        }
    };
    unsafe_store(state, new_bump);
    new_bump
}

fn gc_collect(state: number) -> number {
    let heap_base = runtime_heap_base();
    let heap_limit = runtime_heap_limit();
    let stack_bottom = runtime_stack_bottom();
    let scan_stack = stack_bottom;
    let stack_end = stack_bottom + 512;
    while scan_stack < stack_end {
        let val = unsafe_load(scan_stack);
        if val >= heap_base {
            if val < heap_limit {
                if val > state + 16 {
                    gc_mark(val, heap_base, heap_limit, state)
                } else {
                    0
                }
            } else {
                0
            }
        } else {
            0
        };
        scan_stack = scan_stack + 8
    };
    gc_sweep(state)
}

fn main() -> number {
    let state = gc_init();
    let p1 = gc_alloc(state, 8);
    unsafe_store(p1, 100);
    let p2 = gc_alloc(state, 8);
    unsafe_store(p2, 200);
    let p3 = gc_alloc(state, 16);
    unsafe_store(p3, 300);
    unsafe_store(p3 + 8, 400);
    gc_collect(state);
    let p4 = gc_alloc(state, 8);
    unsafe_store(p4, 500);
    unsafe_load(p1) + unsafe_load(p2) + unsafe_load(p3) + unsafe_load(p3 + 8) + unsafe_load(p4)
}
