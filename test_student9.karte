struct Student {
    name: string,
    score: number
}

fn make_student(name: string, score: number) -> Student {
    Student { name: name, score: score }
}

fn get_grade(s: Student) -> string {
    let score = s.score;
    if score >= 90 {
        "A"
    } else {
        if score >= 80 {
            "B"
        } else {
            if score >= 70 {
                "C"
            } else {
                if score >= 60 {
                    "D"
                } else {
                    "F"
                }
            }
        }
    }
}

fn main() -> number {
    let s1 = make_student("Alice", 95);
    let g1 = get_grade(s1);
    print(s1.name + ": " + g1 + "\n");
    0
}
