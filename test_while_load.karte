fn test_while_with_load() -> number {
    let arr = runtime_heap_base();
    let i = 0;
    while i < 40 {
        unsafe_store(arr + i, i);
        i = i + 8
    };
    let j = 0;
    let sum = 0;
    while j < 40 {
        sum = sum + unsafe_load(arr + j);
        j = j + 8
    };
    sum
}

fn main() -> number {
    test_while_with_load()
}
