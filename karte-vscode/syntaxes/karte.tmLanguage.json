{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Karte",
  "scopeName": "source.karte",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#types"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.karte",
          "match": "//.*$"
        },
        {
          "name": "comment.block.karte",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.karte",
          "match": "\\b(if|else|while|match|in|return)\\b"
        },
        {
          "name": "keyword.declaration.karte",
          "match": "\\b(let|fn|struct|enum|module|import|from)\\b"
        },
        {
          "name": "keyword.other.karte",
          "match": "\\b(perform|resume|handle)\\b"
        },
        {
          "name": "constant.language.karte",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.karte",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.karte",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.karte",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.karte",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.karte",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.karte",
          "match": "\\+|\\-|\\*|/|%"
        },
        {
          "name": "keyword.operator.comparison.karte",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.karte",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.karte",
          "match": "="
        },
        {
          "name": "keyword.operator.arrow.karte",
          "match": "->"
        },
        {
          "name": "keyword.operator.reference.karte",
          "match": "&|\\*"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.karte",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        },
        {
          "name": "entity.name.function.definition.karte",
          "match": "(?<=fn\\s+)([a-zA-Z_][a-zA-Z0-9_]*)"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.karte",
          "match": "\\b(number|bool|string|Option|Result)\\b"
        },
        {
          "name": "entity.name.type.karte",
          "match": "\\b([A-Z][a-zA-Z0-9_]*)\\b"
        },
        {
          "name": "storage.modifier.karte",
          "match": "(?<=:)\\s*([a-zA-Z_][a-zA-Z0-9_]*)"
        }
      ]
    }
  }
}
