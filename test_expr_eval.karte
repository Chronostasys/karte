enum Expr {
    Num(number),
    Add(Expr, Expr),
    Mul(Expr, Expr)
}

fn eval(e: Expr) -> number {
    match e {
        Num(n) => n,
        Add(a, b) => eval(a) + eval(b),
        Mul(a, b) => eval(a) * eval(b)
    }
}

fn main() -> number {
    let expr = Add(Num(3), Mul(Num(4), Num(5)));
    eval(expr)
}
