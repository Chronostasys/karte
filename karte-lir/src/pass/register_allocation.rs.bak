//! 寄存器分配Pass
//! 
//! 实现工业级寄存器分配算法，包括线性扫描和图着色
//! 这是编译器后端的核心优化pass之一

use super::{FunctionPass, PassResult, AnalysisManager, AnalysisResult, AnalysisPass};
use crate::{LirFunction, RegisterId, Instruction, Operand};
use std::collections::{HashMap, HashSet};
use std::any::Any;
use karte_diagnostics::Span;

// 为指令添加获取span的辅助方法
trait InstructionExt {
    fn get_span(&self) -> Span;
}

impl InstructionExt for Instruction {
    fn get_span(&self) -> Span {
        match self {
            Instruction::Move { span, .. } |
            Instruction::Add { span, .. } |
            Instruction::Sub { span, .. } |
            Instruction::Mul { span, .. } |
            Instruction::Div { span, .. } |
            Instruction::Compare { span, .. } |
            Instruction::Jump { span, .. } |
            Instruction::JumpEqual { span, .. } |
            Instruction::JumpNotEqual { span, .. } |
            Instruction::JumpLess { span, .. } |
            Instruction::JumpLessEqual { span, .. } |
            Instruction::JumpGreater { span, .. } |
            Instruction::JumpGreaterEqual { span, .. } |
            Instruction::Call { span, .. } |
            Instruction::CallIndirect { span, .. } |
            Instruction::Return { span, .. } |
            Instruction::Label { span, .. } |
            Instruction::Nop { span, .. } |
            Instruction::Load64 { span, .. } |
            Instruction::Store64 { span, .. } |
            Instruction::Alloc { span, .. } |
            Instruction::StructAlloc { span, .. } |
            Instruction::StructFieldLoad { span, .. } |
            Instruction::StructFieldStore { span, .. } |
            Instruction::Phi { span, .. } => *span,
            _ => Span::dummy(),
        }
    }
}

/// 寄存器分配结果
#[derive(Debug, Clone)]
pub struct RegisterAllocationResult {
    /// 虚拟寄存器到物理寄存器的映射
    pub register_mapping: HashMap<RegisterId, u8>,
    /// 溢出的寄存器及其栈槽信息
    pub spilled_registers: HashMap<RegisterId, SpillSlot>,
    /// 分配统计信息
    pub stats: AllocationStats,
}

impl AnalysisResult for RegisterAllocationResult {
    fn as_any(&self) -> &dyn Any {
        self
    }
}

/// 溢出槽信息（简化版，只记录逻辑槽号）
#[derive(Debug, Clone)]
pub struct SpillSlot {
    pub slot_id: usize,
    // 🔧 移除 stack_offset，将由 StackFrameLowering Pass 计算
}

/// 分配统计信息
#[derive(Debug, Clone)]
pub struct AllocationStats {
    pub total_virtual_registers: usize,
    pub allocated_physical_registers: usize,
    pub spilled_registers: usize,
    pub register_pressure: usize,
}

/// 寄存器生命周期信息
#[derive(Debug, Clone)]
pub struct RegisterLifetime {
    pub register: RegisterId,
    pub start: usize,
    pub end: usize,
    pub uses: Vec<usize>,
    /// 🔧 新增：是否是函数参数
    pub is_function_parameter: bool,
    /// 🔧 新增：参数索引（如果是函数参数）
    pub parameter_index: Option<usize>,
}

/// 调用约定接口（简化版，避免循环依赖）
#[derive(Debug, Clone)]
pub struct SimpleCallingConvention {
    /// 参数传递寄存器
    pub argument_registers: Vec<u8>,
    /// 返回值寄存器
    pub return_register: u8,
    /// 栈指针寄存器
    pub stack_pointer: u8,
    /// 帧指针寄存器
    pub frame_pointer: u8,
    /// 返回地址寄存器
    pub return_address: u8,
    /// 可分配的寄存器
    pub allocatable_registers: Vec<u8>,
}

impl Default for SimpleCallingConvention {
    fn default() -> Self {
        Self {
            argument_registers: vec![1, 2, 3, 4],
            return_register: 0,
            stack_pointer: 6,
            frame_pointer: 7,
            return_address: 5,
            allocatable_registers: vec![0, 1, 2, 3, 4], // r0-r4 可分配，r5-r7 特殊用途
        }
    }
}

/// 寄存器分配运行模式
#[derive(Debug, Clone, PartialEq)]
pub enum RegisterAllocationMode {
    /// 决策模式（Pre-RA）：只做分析决策，不修改代码
    DecisionOnly,
    /// 改写模式（Final-RA）：执行最终的寄存器替换
    FinalRewrite,
}

/// 线性扫描寄存器分配Pass
pub struct LinearScanRegisterAllocation {
    /// 调用约定
    calling_convention: SimpleCallingConvention,
    /// 保留的特殊寄存器（栈指针、帧指针等）
    reserved_registers: HashSet<u8>,
    /// 🔧 新增：运行模式
    mode: RegisterAllocationMode,
}

impl LinearScanRegisterAllocation {
    pub fn new() -> Self {
        let calling_convention = SimpleCallingConvention::default();
        let mut reserved = HashSet::new();
        reserved.insert(calling_convention.stack_pointer);
        reserved.insert(calling_convention.frame_pointer);
        reserved.insert(calling_convention.return_address);
        
        Self {
            calling_convention,
            reserved_registers: reserved,
            mode: RegisterAllocationMode::FinalRewrite, // 默认为最终改写模式
        }
    }
    
    /// 🔧 新增：创建决策模式的寄存器分配器（Pre-RA）
    pub fn new_decision_only() -> Self {
        let mut allocator = Self::new();
        allocator.mode = RegisterAllocationMode::DecisionOnly;
        allocator
    }
    
    /// 🔧 新增：创建最终改写模式的寄存器分配器（Final-RA）
    pub fn new_final_rewrite() -> Self {
        let mut allocator = Self::new();
        allocator.mode = RegisterAllocationMode::FinalRewrite;
        allocator
    }
    
    /// 🔧 新增：设置运行模式
    pub fn with_mode(mut self, mode: RegisterAllocationMode) -> Self {
        self.mode = mode;
        self
    }
    
    /// 分析寄存器生命周期
    fn analyze_lifetimes(&self, function: &LirFunction) -> Vec<RegisterLifetime> {
        let mut lifetimes = HashMap::new();
        
        // 🔧 修复：首先识别和处理函数参数
        for (param_idx, &param_reg) in function.parameter_registers.iter().enumerate() {
            let lifetime = RegisterLifetime {
                register: param_reg,
                start: 0,  // 从函数开始
                end: function.instructions.len().saturating_sub(1),  // 到函数结束
                uses: Vec::new(),
                is_function_parameter: true,  // 标记为函数参数
                parameter_index: Some(param_idx),  // 参数索引
            };
            lifetimes.insert(param_reg, lifetime);
            println!("🔧 识别函数参数寄存器: {:?} (参数索引: {})", param_reg, param_idx);
        }
        
        // 扫描所有指令，记录寄存器的使用
        for (i, instruction) in function.instructions.iter().enumerate() {
            let registers = self.extract_registers_from_instruction(instruction);
            
            for reg in registers {
                let lifetime = lifetimes.entry(reg).or_insert_with(|| RegisterLifetime {
                    register: reg,
                    start: i,
                    end: i,
                    uses: Vec::new(),
                    is_function_parameter: false,
                    parameter_index: None,
                });
                
                // 更新生命周期范围
                if !lifetime.is_function_parameter {
                    lifetime.end = i;
                } else {
                    // 函数参数的生命周期延伸到整个函数
                    lifetime.end = function.instructions.len().saturating_sub(1);
                }
                lifetime.uses.push(i);
            }
        }
        
        lifetimes.into_values().collect()
    }
    
    /// 从指令中提取所有使用的寄存器
    fn extract_registers_from_instruction(&self, instruction: &Instruction) -> Vec<RegisterId> {
        let mut registers = Vec::new();
        
        match instruction {
            Instruction::Move { dst, src, .. } => {
                registers.push(*dst);
                if let Operand::Register { id } = src {
                    registers.push(*id);
                }
            }
            Instruction::Add { dst, src1, src2, .. } |
            Instruction::Sub { dst, src1, src2, .. } |
            Instruction::Mul { dst, src1, src2, .. } |
            Instruction::Div { dst, src1, src2, .. } => {
                registers.push(*dst);
                if let Operand::Register { id } = src1 {
                    registers.push(*id);
                }
                if let Operand::Register { id } = src2 {
                    registers.push(*id);
                }
            }
            Instruction::Store64 { addr, src, .. } => {
                registers.push(*addr);
                if let Operand::Register { id } = src {
                    registers.push(*id);
                }
            }
            Instruction::Load64 { dst, addr, .. } => {
                registers.push(*dst);
                registers.push(*addr);
            }
            Instruction::Compare { src1, src2, .. } => {
                if let Operand::Register { id } = src1 {
                    registers.push(*id);
                }
                if let Operand::Register { id } = src2 {
                    registers.push(*id);
                }
            }
            Instruction::Return { value, .. } => {
                if let Some(reg) = value {
                    registers.push(*reg);
                }
            }
            Instruction::CallIndirect { function_register, args, result, .. } => {
                registers.push(*function_register);
                registers.extend_from_slice(args);
                if let Some(result_reg) = result {
                    registers.push(*result_reg);
                }
            }
            Instruction::Call { args, result, .. } => {
                registers.extend_from_slice(args);
                if let Some(result_reg) = result {
                    registers.push(*result_reg);
                }
            }
            Instruction::Alloc { dst, .. } |
            Instruction::StructAlloc { dst, .. } => {
                registers.push(*dst);
            }
            Instruction::StructFieldStore { struct_addr, src, .. } => {
                registers.push(*struct_addr);
                if let Operand::Register { id } = src {
                    registers.push(*id);
                }
            }
            Instruction::StructFieldLoad { dst, struct_addr, .. } => {
                registers.push(*dst);
                registers.push(*struct_addr);
            }
            Instruction::JumpEqual { .. } |
            Instruction::JumpNotEqual { .. } |
            Instruction::Jump { .. } |
            Instruction::Label { .. } => {
                // 跳转指令不涉及寄存器
            }
            _ => {} // 其他指令暂时忽略
        }
        
        registers
    }
    
    /// 执行线性扫描寄存器分配
    fn perform_linear_scan(&self, mut lifetimes: Vec<RegisterLifetime>, function: &LirFunction) -> RegisterAllocationResult {
        // 🔧 新增：收集所有由alloc指令生成的栈地址寄存器
        // 这些寄存器存储栈地址，不应该被溢出
        let mut stack_address_registers = std::collections::HashSet::new();
        for instruction in &function.instructions {
            if let Instruction::Alloc { dst, .. } = instruction {
                stack_address_registers.insert(*dst);
                println!("🔧 识别栈地址寄存器: {:?} (由alloc指令生成，不应被溢出)", dst);
            }
        }
        
        // 🔧 修复：按优先级和开始位置排序
        lifetimes.sort_by(|a, b| {
            let priority_a = self.get_lifetime_priority(a);
            let priority_b = self.get_lifetime_priority(b);
            
            match priority_b.cmp(&priority_a) {
                std::cmp::Ordering::Equal => a.start.cmp(&b.start),
                other => other
            }
        });
        
        let mut register_mapping = HashMap::new();
        let mut spilled_registers = HashMap::new();
        let mut active_intervals: Vec<RegisterLifetime> = Vec::new();
        let mut available_registers = self.get_available_physical_registers();
        
        // 🔧 专业修复：预先保留特殊寄存器和参数寄存器
        let mut reserved_registers = std::collections::HashSet::new();
        reserved_registers.insert(self.calling_convention.stack_pointer);
        reserved_registers.insert(self.calling_convention.frame_pointer);
        reserved_registers.insert(self.calling_convention.return_address);
        
        // 暂时不从可分配池中移除参数寄存器，因为它们可能被其他寄存器使用
        // 只有当它们真正被用作参数时才保留
        
        let mut spill_slot_counter = 0;
        
        for current_lifetime in &lifetimes {
            // 释放已结束的区间
            let mut i = 0;
            while i < active_intervals.len() {
                if active_intervals[i].end < current_lifetime.start {
                    let ended = active_intervals.remove(i);
                    if let Some(&physical_reg) = register_mapping.get(&ended.register) {
                        // 🔧 关键修复：只有非保留寄存器才能被释放并重新分配
                        if !self.reserved_registers.contains(&physical_reg) {
                            available_registers.push(physical_reg);
                            println!("🔧 释放寄存器 r{} (生命周期结束: {:?})", physical_reg, ended.register);
                        } else {
                            println!("🔧 保留寄存器 r{} 不会被释放 (生命周期结束: {:?})", physical_reg, ended.register);
                        }
                    }
                } else {
                    i += 1;
                }
            }
            
            // 🔧 专业修复：特殊寄存器和函数参数寄存器直接映射到自己
            if current_lifetime.register.0 == self.calling_convention.stack_pointer as usize {
                register_mapping.insert(current_lifetime.register, self.calling_convention.stack_pointer);
                active_intervals.push(current_lifetime.clone());
                continue;
            }
            if current_lifetime.register.0 == self.calling_convention.frame_pointer as usize {
                register_mapping.insert(current_lifetime.register, self.calling_convention.frame_pointer);
                active_intervals.push(current_lifetime.clone());
                continue;
            }
            if current_lifetime.register.0 == self.calling_convention.return_address as usize {
                register_mapping.insert(current_lifetime.register, self.calling_convention.return_address);
                active_intervals.push(current_lifetime.clone());
                continue;
            }
            
            // 🔧 关键修复：基于生命周期信息正确识别函数参数
            if current_lifetime.is_function_parameter {
                if let Some(param_idx) = current_lifetime.parameter_index {
                    if param_idx < self.calling_convention.argument_registers.len() {
                        let physical_reg = self.calling_convention.argument_registers[param_idx];
                        register_mapping.insert(current_lifetime.register, physical_reg);
                        active_intervals.push(current_lifetime.clone());
                        
                        // 从可分配寄存器池中移除这个寄存器，防止被其他虚拟寄存器使用
                        available_registers.retain(|&r| r != physical_reg);
                        
                        println!("🔧 函数参数寄存器 {:?} (参数{}) 映射到 r{}，从可分配池中移除", 
                                current_lifetime.register, param_idx, physical_reg);
                        continue;
                    }
                }
            }
            
            // 返回值寄存器也映射到自己
            if current_lifetime.register.0 == self.calling_convention.return_register as usize {
                register_mapping.insert(current_lifetime.register, self.calling_convention.return_register);
                active_intervals.push(current_lifetime.clone());
                continue;
            }
            
            // 🔧 加强冲突检测：检查是否与任何活跃区间重叠
            let mut conflicts = Vec::new();
            for active in &active_intervals {
                // 检查生命周期是否重叠
                if current_lifetime.start <= active.end && current_lifetime.end >= active.start {
                    conflicts.push(active.clone());
                }
            }
            
            if !conflicts.is_empty() {
                println!("🔧 发现冲突: {:?} 与 {:?} 个活跃区间冲突", current_lifetime.register, conflicts.len());
                for conflict in &conflicts {
                    println!("🔧   冲突区间: {:?} [{}-{}]", conflict.register, conflict.start, conflict.end);
                }
                
                // 尝试为当前寄存器找到一个不冲突的物理寄存器
                let mut assigned = false;
                for &physical_reg in &available_registers.clone() {
                    let mut can_use = true;
                    
                    // 检查这个物理寄存器是否被任何冲突的虚拟寄存器使用
                    for conflict in &conflicts {
                        if let Some(&conflict_physical) = register_mapping.get(&conflict.register) {
                            if conflict_physical == physical_reg {
                                can_use = false;
                                break;
                            }
                        }
                    }
                    
                    if can_use {
                        println!("🔧 为 {:?} 分配无冲突寄存器 r{}", current_lifetime.register, physical_reg);
                        register_mapping.insert(current_lifetime.register, physical_reg);
                        available_registers.retain(|&r| r != physical_reg);
                        active_intervals.push(current_lifetime.clone());
                        assigned = true;
                        break;
                    }
                }
                
                if !assigned {
                    // 🔧 关键修复：检查当前寄存器是否为栈地址寄存器
                    if stack_address_registers.contains(&current_lifetime.register) {
                        panic!(
                            "栈地址寄存器 {:?} 不能被溢出！这表明寄存器分配策略有问题。\
                            栈地址寄存器应该有更高的优先级或者使用专门的分配策略。",
                            current_lifetime.register
                        );
                    }

                    // 如果没有可用的无冲突寄存器，尝试溢出
                    println!("🔧 无可用寄存器，尝试溢出策略");
                    if let Some(spill_candidate) = self.find_spill_candidate(&active_intervals, &current_lifetime, &stack_address_registers) {
                        println!("🔧 选择溢出候选: {:?}", spill_candidate.register);
                        
                        // 移除被溢出的寄存器
                        active_intervals.retain(|interval| interval.register != spill_candidate.register);
                        let freed_register = register_mapping.remove(&spill_candidate.register).unwrap();
                        
                        // 记录溢出操作（只记录逻辑槽号）
                        spilled_registers.insert(spill_candidate.register, SpillSlot {
                            slot_id: spill_slot_counter,
                        });
                        spill_slot_counter += 1;
                        
                        // 将释放的寄存器分配给当前寄存器
                        register_mapping.insert(current_lifetime.register, freed_register);
                        active_intervals.push(current_lifetime.clone());
                        
                        println!("🔧 溢出完成: {:?} -> slot {}, {:?} -> r{}", 
                                spill_candidate.register, spill_slot_counter - 1, 
                                current_lifetime.register, freed_register);
                    } else {
                        // 🔧 关键改进：即使找不到理想候选，也要尝试其他策略
                        println!("🚨 找不到溢出候选，尝试直接溢出当前寄存器");
                        
                        // 再次检查当前寄存器是否为栈地址寄存器
                        if stack_address_registers.contains(&current_lifetime.register) {
                            panic!(
                                "无法溢出栈地址寄存器 {:?}，这是一个严重的寄存器分配错误",
                                current_lifetime.register
                            );
                        }
                        
                        // 策略：直接将当前寄存器溢出到栈上
                        spilled_registers.insert(current_lifetime.register, SpillSlot {
                            slot_id: spill_slot_counter,
                        });
                        spill_slot_counter += 1;
                        
                        println!("🔧 直接溢出: {:?} -> slot {}", 
                                current_lifetime.register, spill_slot_counter - 1);
                    }
                }
                continue;
            }
            
            // 🔧 正常分配路径：没有冲突时的寄存器分配
            if let Some(physical_reg) = available_registers.pop() {
                println!("🔧 为 {:?} 分配寄存器 r{} (无冲突)", current_lifetime.register, physical_reg);
                register_mapping.insert(current_lifetime.register, physical_reg);
                active_intervals.push(current_lifetime.clone());
            } else {
                // 没有可用寄存器，需要溢出
                // 🔧 关键修复：检查当前寄存器是否为栈地址寄存器
                if stack_address_registers.contains(&current_lifetime.register) {
                    panic!(
                        "无法溢出栈地址寄存器 {:?}，这是一个严重的寄存器分配错误",
                        current_lifetime.register
                    );
                }
                
                println!("🔧 没有可用寄存器，直接溢出 {:?}", current_lifetime.register);
                spilled_registers.insert(current_lifetime.register, SpillSlot {
                    slot_id: spill_slot_counter,
                });
                spill_slot_counter += 1;
            }
        }
        
        let stats = AllocationStats {
            total_virtual_registers: lifetimes.len(),
            allocated_physical_registers: register_mapping.len(),
            spilled_registers: spilled_registers.len(),
            register_pressure: active_intervals.len(),
        };
        
        RegisterAllocationResult {
            register_mapping,
            spilled_registers,
            stats,
        }
    }
    
    /// 🚀 改进：寻找溢出候选寄存器，确保总是能找到候选者
    fn find_spill_candidate(&self, active_intervals: &[RegisterLifetime], current_lifetime: &RegisterLifetime, stack_address_registers: &HashSet<RegisterId>) -> Option<RegisterLifetime> {
        let current_priority = self.get_lifetime_priority(current_lifetime);
        
        // 策略1：选择结束时间最晚且优先级不高于当前寄存器的寄存器
        let mut best_candidate = None;
        let mut latest_end = current_lifetime.end;
        
        // 首先尝试找到优先级较低的候选者
        for interval in active_intervals {
            let interval_priority = self.get_lifetime_priority(interval);
            
            // 🔧 不溢出特殊寄存器（栈指针、帧指针等）
            if interval_priority >= 950 {
                continue;
            }
            
            // 🔧 关键修复：不溢出栈地址寄存器
            if stack_address_registers.contains(&interval.register) {
                println!("🔧 跳过栈地址寄存器 {:?}，不能作为溢出候选", interval.register);
                continue;
            }
            
            // 选择优先级不高于当前寄存器且结束时间最晚的寄存器
            if interval_priority <= current_priority && interval.end > latest_end {
                latest_end = interval.end;
                best_candidate = Some(interval.clone());
            }
        }
        
        // 策略2：如果没有找到合适的候选者，找到结束时间最晚的非关键寄存器
        if best_candidate.is_none() {
            let mut latest_non_critical = None;
            let mut latest_end_non_critical = 0;
            
            for interval in active_intervals {
                let interval_priority = self.get_lifetime_priority(interval);
                
                // 跳过关键寄存器（特殊寄存器）
                if interval_priority >= 950 {
                    continue;
                }
                
                // 🔧 关键修复：跳过栈地址寄存器
                if stack_address_registers.contains(&interval.register) {
                    continue;
                }
                
                if interval.end > latest_end_non_critical {
                    latest_end_non_critical = interval.end;
                    latest_non_critical = Some(interval.clone());
                }
            }
            
            best_candidate = latest_non_critical;
        }
        
        // 策略3：如果仍然没有找到，使用"最远下次使用"启发式
        if best_candidate.is_none() {
            let mut best_future_use = None;
            let mut furthest_next_use = current_lifetime.start;
            
            for interval in active_intervals {
                let interval_priority = self.get_lifetime_priority(interval);
                
                // 即使是关键寄存器，如果真的没有选择也要考虑
                if interval_priority >= 1000 {
                    continue; // 绝对不溢出系统寄存器
                }
                
                // 🔧 关键修复：跳过栈地址寄存器
                if stack_address_registers.contains(&interval.register) {
                    continue;
                }
                
                // 计算下次使用距离
                let next_use = self.find_next_use(interval, current_lifetime.start);
                if next_use > furthest_next_use {
                    furthest_next_use = next_use;
                    best_future_use = Some(interval.clone());
                }
            }
            
            best_candidate = best_future_use;
        }
        
        // 🔧 关键改进：如果还是没有找到候选者，选择第一个非系统寄存器
        if best_candidate.is_none() && !active_intervals.is_empty() {
            for interval in active_intervals {
                let interval_priority = self.get_lifetime_priority(interval);
                if interval_priority < 1000 { // 不是系统寄存器
                    // 🔧 关键修复：跳过栈地址寄存器
                    if stack_address_registers.contains(&interval.register) {
                        continue;
                    }
                    best_candidate = Some(interval.clone());
                    break;
                }
            }
        }
        
        if best_candidate.is_some() {
            println!("🔧 选择溢出候选: {:?}", best_candidate.as_ref().unwrap().register);
        } else {
            println!("🚨 警告: 未找到合适的溢出候选，可能会导致分配失败");
        }
        
        best_candidate
    }
    
    /// 🔧 新增：查找寄存器的下一次使用位置
    fn find_next_use(&self, lifetime: &RegisterLifetime, from_position: usize) -> usize {
        for &use_pos in &lifetime.uses {
            if use_pos > from_position {
                return use_pos;
            }
        }
        // 如果没有更多使用，返回生命周期结束位置
        lifetime.end
    }
    
    /// 获取寄存器的分配优先级
    fn get_register_priority(&self, register: RegisterId) -> u32 {
        match register.0 {
            // 特殊寄存器最高优先级
            id if id == self.calling_convention.stack_pointer as usize => 1000,
            id if id == self.calling_convention.frame_pointer as usize => 1000,
            id if id == self.calling_convention.return_address as usize => 1000,
            
            // 返回值寄存器
            id if id == self.calling_convention.return_register as usize => 800,
            
            // 其他可分配寄存器
            0..=4 => 100,
            
            // 其他寄存器
            _ => 10,
        }
    }
    
    /// 🔧 新增：获取寄存器生命周期的分配优先级（考虑函数参数）
    fn get_lifetime_priority(&self, lifetime: &RegisterLifetime) -> u32 {
        // 函数参数有最高优先级（仅次于特殊寄存器）
        if lifetime.is_function_parameter {
            return 950;
        }
        
        // 使用原有的寄存器优先级
        self.get_register_priority(lifetime.register)
    }
    
    // 🔧 移除溢出代码生成：现在由 StackFrameLowering Pass 处理
    
    /// 🚀 新增：在单个指令中替换溢出寄存器为临时寄存器
    fn replace_spilled_registers_in_instruction(&self, instruction: &mut Instruction, spill_mapping: &HashMap<RegisterId, RegisterId>) -> Result<(), String> {
        match instruction {
            Instruction::Move { dst, src, .. } => {
                if let Some(&temp_reg) = spill_mapping.get(dst) {
                    *dst = temp_reg;
                }
                if let Operand::Register { id } = src {
                    if let Some(&temp_reg) = spill_mapping.get(id) {
                        *id = temp_reg;
                    }
                }
            }
            Instruction::Add { dst, src1, src2, .. } |
            Instruction::Sub { dst, src1, src2, .. } |
            Instruction::Mul { dst, src1, src2, .. } |
            Instruction::Div { dst, src1, src2, .. } => {
                if let Some(&temp_reg) = spill_mapping.get(dst) {
                    *dst = temp_reg;
                }
                if let Operand::Register { id } = src1 {
                    if let Some(&temp_reg) = spill_mapping.get(id) {
                        *id = temp_reg;
                    }
                }
                if let Operand::Register { id } = src2 {
                    if let Some(&temp_reg) = spill_mapping.get(id) {
                        *id = temp_reg;
                    }
                }
            }
            Instruction::Store64 { addr, src, .. } => {
                if let Some(&temp_reg) = spill_mapping.get(addr) {
                    *addr = temp_reg;
                }
                if let Operand::Register { id } = src {
                    if let Some(&temp_reg) = spill_mapping.get(id) {
                        *id = temp_reg;
                    }
                }
            }
            Instruction::Load64 { dst, addr, .. } => {
                if let Some(&temp_reg) = spill_mapping.get(dst) {
                    *dst = temp_reg;
                }
                if let Some(&temp_reg) = spill_mapping.get(addr) {
                    *addr = temp_reg;
                }
            }
            Instruction::Compare { src1, src2, .. } => {
                if let Operand::Register { id } = src1 {
                    if let Some(&temp_reg) = spill_mapping.get(id) {
                        *id = temp_reg;
                    }
                }
                if let Operand::Register { id } = src2 {
                    if let Some(&temp_reg) = spill_mapping.get(id) {
                        *id = temp_reg;
                    }
                }
            }
            Instruction::Return { value, .. } => {
                if let Some(reg) = value {
                    if let Some(&temp_reg) = spill_mapping.get(reg) {
                        *reg = temp_reg;
                    }
                }
            }
            Instruction::CallIndirect { function_register, args, result, .. } => {
                if let Some(&temp_reg) = spill_mapping.get(function_register) {
                    *function_register = temp_reg;
                }
                for arg in args {
                    if let Some(&temp_reg) = spill_mapping.get(arg) {
                        *arg = temp_reg;
                    }
                }
                if let Some(result_reg) = result {
                    if let Some(&temp_reg) = spill_mapping.get(result_reg) {
                        *result_reg = temp_reg;
                    }
                }
            }
            Instruction::Call { args, result, .. } => {
                for arg in args {
                    if let Some(&temp_reg) = spill_mapping.get(arg) {
                        *arg = temp_reg;
                    }
                }
                if let Some(result_reg) = result {
                    if let Some(&temp_reg) = spill_mapping.get(result_reg) {
                        *result_reg = temp_reg;
                    }
                }
            }
            Instruction::Alloc { dst, .. } |
            Instruction::StructAlloc { dst, .. } => {
                if let Some(&temp_reg) = spill_mapping.get(dst) {
                    *dst = temp_reg;
                }
            }
            Instruction::StructFieldStore { struct_addr, src, .. } => {
                if let Some(&temp_reg) = spill_mapping.get(struct_addr) {
                    *struct_addr = temp_reg;
                }
                if let Operand::Register { id } = src {
                    if let Some(&temp_reg) = spill_mapping.get(id) {
                        *id = temp_reg;
                    }
                }
            }
            Instruction::StructFieldLoad { dst, struct_addr, .. } => {
                if let Some(&temp_reg) = spill_mapping.get(dst) {
                    *dst = temp_reg;
                }
                if let Some(&temp_reg) = spill_mapping.get(struct_addr) {
                    *struct_addr = temp_reg;
                }
            }
            _ => {} // 其他指令不涉及寄存器或已处理
        }
        
        Ok(())
    }
    
    /// 🚀 新增：获取指令中使用的溢出寄存器
    fn get_spilled_registers_in_instruction(&self, instruction: &Instruction, spilled_registers: &HashMap<RegisterId, SpillSlot>) -> Vec<RegisterId> {
        let mut used_regs = Vec::new();
        
        match instruction {
            Instruction::Move { src, .. } => {
                if let Operand::Register { id } = src {
                    if spilled_registers.contains_key(id) {
                        used_regs.push(*id);
                    }
                }
            }
            Instruction::Add { src1, src2, .. } |
            Instruction::Sub { src1, src2, .. } |
            Instruction::Mul { src1, src2, .. } |
            Instruction::Div { src1, src2, .. } => {
                if let Operand::Register { id } = src1 {
                    if spilled_registers.contains_key(id) {
                        used_regs.push(*id);
                    }
                }
                if let Operand::Register { id } = src2 {
                    if spilled_registers.contains_key(id) {
                        used_regs.push(*id);
                    }
                }
            }
            Instruction::Store64 { addr, src, .. } => {
                if spilled_registers.contains_key(addr) {
                    used_regs.push(*addr);
                }
                if let Operand::Register { id } = src {
                    if spilled_registers.contains_key(id) {
                        used_regs.push(*id);
                    }
                }
            }
            Instruction::Load64 { addr, .. } => {
                if spilled_registers.contains_key(addr) {
                    used_regs.push(*addr);
                }
            }
            // 其他指令类型根据需要添加
            _ => {}
        }
        
        used_regs
    }
    
    /// 🚀 新增：获取指令中定义的溢出寄存器
    fn get_defined_spilled_registers_in_instruction(&self, instruction: &Instruction, spilled_registers: &HashMap<RegisterId, SpillSlot>) -> Vec<RegisterId> {
        let mut defined_regs = Vec::new();
        
        match instruction {
            Instruction::Move { dst, .. } |
            Instruction::Add { dst, .. } |
            Instruction::Sub { dst, .. } |
            Instruction::Mul { dst, .. } |
            Instruction::Div { dst, .. } |
            Instruction::Load64 { dst, .. } |
            Instruction::Alloc { dst, .. } |
            Instruction::StructAlloc { dst, .. } |
            Instruction::StructFieldLoad { dst, .. } => {
                if spilled_registers.contains_key(dst) {
                    defined_regs.push(*dst);
                }
            }
            Instruction::CallIndirect { result: Some(dst), .. } |
            Instruction::Call { result: Some(dst), .. } => {
                if spilled_registers.contains_key(dst) {
                    defined_regs.push(*dst);
                }
            }
            _ => {}
        }
        
        defined_regs
    }
    
    /// 🚀 新增：为溢出寄存器分配临时物理寄存器
    fn allocate_temporary_register(&self, spilled_reg: RegisterId) -> RegisterId {
        // 简单策略：使用溢出寄存器的ID映射到可用的物理寄存器
        // 更复杂的实现可以使用寄存器池管理
        let temp_physical = (spilled_reg.0 % self.calling_convention.allocatable_registers.len()) as u8;
        let physical_reg = self.calling_convention.allocatable_registers[temp_physical as usize];
        // 🔧 修复：直接返回物理寄存器ID，这样就不需要后续映射
        RegisterId(physical_reg as usize)
    }
    
    /// 🔧 修改：在LIR指令中应用寄存器分配，包括溢出代码生成
    fn apply_register_allocation(&self, function: &mut LirFunction, allocation: &RegisterAllocationResult) -> Result<(), String> {
        // 🔧 修复：创建一个扩展的映射表，包含临时寄存器的映射
        let mut extended_mapping = allocation.register_mapping.clone();
        
        // 🔧 修复：确保特殊寄存器被正确映射
        extended_mapping.insert(RegisterId(self.calling_convention.stack_pointer as usize), self.calling_convention.stack_pointer);
        extended_mapping.insert(RegisterId(self.calling_convention.frame_pointer as usize), self.calling_convention.frame_pointer);
        extended_mapping.insert(RegisterId(self.calling_convention.return_address as usize), self.calling_convention.return_address);
        println!("🔧 添加特殊寄存器映射: r{} -> r{} (SP)", self.calling_convention.stack_pointer, self.calling_convention.stack_pointer);
        println!("🔧 添加特殊寄存器映射: r{} -> r{} (FP)", self.calling_convention.frame_pointer, self.calling_convention.frame_pointer);
        println!("🔧 添加特殊寄存器映射: r{} -> r{} (RA)", self.calling_convention.return_address, self.calling_convention.return_address);
        
        // 遍历所有指令，替换虚拟寄存器为物理寄存器
        for instruction in &mut function.instructions {
            self.replace_registers_in_instruction(instruction, &extended_mapping, &allocation.spilled_registers)?;
        }
        
        Ok(())
    }
    
    /// 🔧 新增：在单个指令中替换寄存器
    fn replace_registers_in_instruction(&self, instruction: &mut Instruction, mapping: &HashMap<RegisterId, u8>, spilled_registers: &HashMap<RegisterId, SpillSlot>) -> Result<(), String> {
        match instruction {
            Instruction::Move { dst, src, .. } => {
                // 只替换非溢出寄存器
                if !spilled_registers.contains_key(dst) {
                    *dst = self.map_register(*dst, mapping)?;
                }
                self.replace_operand_register(src, mapping, spilled_registers)?;
            }
            Instruction::Add { dst, src1, src2, .. } |
            Instruction::Sub { dst, src1, src2, .. } |
            Instruction::Mul { dst, src1, src2, .. } |
            Instruction::Div { dst, src1, src2, .. } => {
                if !spilled_registers.contains_key(dst) {
                    *dst = self.map_register(*dst, mapping)?;
                }
                self.replace_operand_register(src1, mapping, spilled_registers)?;
                self.replace_operand_register(src2, mapping, spilled_registers)?;
            }
            Instruction::Compare { src1, src2, .. } => {
                self.replace_operand_register(src1, mapping, spilled_registers)?;
                self.replace_operand_register(src2, mapping, spilled_registers)?;
            }
            Instruction::Load64 { dst, addr, .. } => {
                if !spilled_registers.contains_key(dst) {
                    *dst = self.map_register(*dst, mapping)?;
                }
                if !spilled_registers.contains_key(addr) {
                    *addr = self.map_register(*addr, mapping)?;
                }
            }
            Instruction::Store64 { addr, src, .. } => {
                if !spilled_registers.contains_key(addr) {
                    *addr = self.map_register(*addr, mapping)?;
                }
                self.replace_operand_register(src, mapping, spilled_registers)?;
            }
            Instruction::Call { args, result, .. } => {
                for arg in args {
                    if !spilled_registers.contains_key(arg) {
                        *arg = self.map_register(*arg, mapping)?;
                    }
                }
                if let Some(res) = result {
                    if !spilled_registers.contains_key(res) {
                        *res = self.map_register(*res, mapping)?;
                    }
                }
            }
            Instruction::CallIndirect { function_register, args, result, .. } => {
                if !spilled_registers.contains_key(function_register) {
                    *function_register = self.map_register(*function_register, mapping)?;
                }
                for arg in args {
                    if !spilled_registers.contains_key(arg) {
                        *arg = self.map_register(*arg, mapping)?;
                    }
                }
                if let Some(res) = result {
                    if !spilled_registers.contains_key(res) {
                        *res = self.map_register(*res, mapping)?;
                    }
                }
            }
            Instruction::Return { value, .. } => {
                if let Some(val) = value {
                    if !spilled_registers.contains_key(val) {
                        *val = self.map_register(*val, mapping)?;
                    }
                }
            }
            Instruction::Alloc { dst, .. } => {
                if !spilled_registers.contains_key(dst) {
                    *dst = self.map_register(*dst, mapping)?;
                }
            }
            // 其他指令类型根据需要添加
            _ => {}
        }
        Ok(())
    }

    /// 替换操作数中的寄存器
    fn replace_operand_register(&self, operand: &mut Operand, mapping: &HashMap<RegisterId, u8>, spilled_registers: &HashMap<RegisterId, SpillSlot>) -> Result<(), String> {
        if let Operand::Register { id } = operand {
            if !spilled_registers.contains_key(id) {
                *id = self.map_register(*id, mapping)?;
            }
        }
        Ok(())
    }
    
    /// 🔧 新增：映射单个寄存器
    fn map_register(&self, virtual_reg: RegisterId, mapping: &HashMap<RegisterId, u8>) -> Result<RegisterId, String> {
        if let Some(&physical_reg) = mapping.get(&virtual_reg) {
            Ok(RegisterId(physical_reg as usize))
        } else {
            Err(format!("虚拟寄存器 {:?} 没有分配到物理寄存器", virtual_reg))
        }
    }

    /// 🔧 新增：基于CFG的精确生命周期分析
    fn analyze_lifetimes_with_cfg(
        &self, 
        function: &LirFunction, 
        cfg: &crate::pass::analysis::ControlFlowGraph,
        def_use: &crate::pass::analysis::DefUseChains
    ) -> Vec<RegisterLifetime> {
        // 1. 计算活跃度分析
        let liveness = self.compute_liveness(cfg, def_use);
        
        // 2. 构建精确的生命周期区间
        let mut lifetimes = HashMap::new();
        
        // 🔧 修复：首先识别和处理函数参数
        for (param_idx, &param_reg) in function.parameter_registers.iter().enumerate() {
            let lifetime = RegisterLifetime {
                register: param_reg,
                start: 0,  // 从函数开始
                end: function.instructions.len().saturating_sub(1),  // 到函数结束
                uses: Vec::new(),
                is_function_parameter: true,  // 标记为函数参数
                parameter_index: Some(param_idx),  // 参数索引
            };
            lifetimes.insert(param_reg, lifetime);
            println!("🔧 识别函数参数寄存器: {:?} (参数索引: {})", param_reg, param_idx);
        }
        
        // 3. 为每个寄存器计算精确的生命周期
        for (&register, def_positions) in &def_use.definitions {
            if lifetimes.contains_key(&register) {
                // 函数参数已经处理过了
                continue;
            }
            
            // 计算此寄存器的生命周期
            let mut start = usize::MAX;
            let mut end = 0;
            let mut uses = Vec::new();
            
            // 从定义位置开始
            for &def_pos in def_positions {
                start = start.min(def_pos);
                end = end.max(def_pos);
            }
            
            // 添加使用位置
            if let Some(use_positions) = def_use.uses.get(&register) {
                for &use_pos in use_positions {
                    uses.push(use_pos);
                    end = end.max(use_pos);
                }
            }
            
            // 使用活跃度信息进一步精确化生命周期
            let refined_end = self.refine_lifetime_end(register, end, &liveness);
            
            let lifetime = RegisterLifetime {
                register,
                start,
                end: refined_end,
                uses,
                is_function_parameter: false,
                parameter_index: None,
            };
            
            lifetimes.insert(register, lifetime);
        }
        
        lifetimes.into_values().collect()
    }
    
    /// 🔧 新增：计算活跃度分析
    fn compute_liveness(
        &self,
        cfg: &crate::pass::analysis::ControlFlowGraph,
        def_use: &crate::pass::analysis::DefUseChains
    ) -> HashMap<usize, HashSet<RegisterId>> {
        // 为每个基本块计算 use 和 def 集合
        let mut block_use = HashMap::new();
        let mut block_def = HashMap::new();
        
        for node in &cfg.nodes {
            let mut use_set = HashSet::new();
            let mut def_set = HashSet::new();
            
            let (start, end) = node.instruction_range;
            for instr_idx in start..end {
                if let Some(uses) = def_use.instruction_uses.get(&instr_idx) {
                    for &reg in uses {
                        if !def_set.contains(&reg) {
                            use_set.insert(reg);
                        }
                    }
                }
                
                if let Some(defs) = def_use.instruction_defs.get(&instr_idx) {
                    for &reg in defs {
                        def_set.insert(reg);
                    }
                }
            }
            
            block_use.insert(node.block_id, use_set);
            block_def.insert(node.block_id, def_set);
        }
        
        // 执行向后数据流分析
        let mut live_in = HashMap::new();
        let mut live_out = HashMap::new();
        
        // 初始化
        for node in &cfg.nodes {
            live_in.insert(node.block_id, HashSet::new());
            live_out.insert(node.block_id, HashSet::new());
        }
        
        // 迭代直到收敛
        let mut changed = true;
        while changed {
            changed = false;
            
            for node in cfg.nodes.iter().rev() { // 向后遍历
                let block_id = node.block_id;
                
                // live_out[B] = ∪ live_in[S] for all successors S
                let mut new_live_out = HashSet::new();
                for &successor in &node.successors {
                    if let Some(succ_live_in) = live_in.get(&successor) {
                        new_live_out.extend(succ_live_in.iter().copied());
                    }
                }
                
                // live_in[B] = use[B] ∪ (live_out[B] - def[B])
                let mut new_live_in = block_use.get(&block_id).cloned().unwrap_or_default();
                let empty_def_set = HashSet::new();
                let def_set = block_def.get(&block_id).unwrap_or(&empty_def_set);
                for &reg in &new_live_out {
                    if !def_set.contains(&reg) {
                        new_live_in.insert(reg);
                    }
                }
                
                // 检查是否有变化
                if live_out.get(&block_id) != Some(&new_live_out) {
                    live_out.insert(block_id, new_live_out);
                    changed = true;
                }
                
                if live_in.get(&block_id) != Some(&new_live_in) {
                    live_in.insert(block_id, new_live_in);
                    changed = true;
                }
            }
        }
        
        // 计算每个指令位置的活跃变量
        let mut live_at_instruction = HashMap::new();
        
        for node in &cfg.nodes {
            let (start, end) = node.instruction_range;
            let mut current_live = live_out.get(&node.block_id).cloned().unwrap_or_default();
            
            // 从基本块末尾向前遍历
            for instr_idx in (start..end).rev() {
                live_at_instruction.insert(instr_idx, current_live.clone());
                
                // 更新活跃集合
                if let Some(defs) = def_use.instruction_defs.get(&instr_idx) {
                    for &reg in defs {
                        current_live.remove(&reg);
                    }
                }
                
                if let Some(uses) = def_use.instruction_uses.get(&instr_idx) {
                    for &reg in uses {
                        current_live.insert(reg);
                    }
                }
            }
        }
        
        live_at_instruction
    }
    
    /// 🔧 新增：使用活跃度信息精确化生命周期结束点
    fn refine_lifetime_end(
        &self,
        register: RegisterId,
        initial_end: usize,
        liveness: &HashMap<usize, HashSet<RegisterId>>
    ) -> usize {
        // 从初始结束点向后查找，找到寄存器真正不再活跃的点
        for instr_idx in (0..=initial_end).rev() {
            if let Some(live_set) = liveness.get(&instr_idx) {
                if !live_set.contains(&register) {
                    return instr_idx;
                }
            }
        }
        
        initial_end
    }

    /// 🔧 新增：封装应用结果的逻辑
    fn apply_and_return_result(
        &self, 
        function: &mut LirFunction, 
        allocation_result: RegisterAllocationResult, 
        analyses: &mut AnalysisManager
    ) -> PassResult {
        match self.apply_register_allocation(function, &allocation_result) {
            Ok(()) => {
                println!("寄存器分配成功应用到函数 {}", function.name);
                println!("分配统计: {:?}", allocation_result.stats);
                
                // 存储分析结果供调试使用
                analyses.store_result(
                    format!("register-allocation-{}", function.name),
                    Box::new(allocation_result)
                );
                
                PassResult::Changed
            }
            Err(e) => {
                eprintln!("🚨 寄存器分配失败: {}", e);
                panic!("寄存器分配失败，程序终止: {}", e);
            }
        }
    }
    
    /// 🔧 新增：决策模式运行逻辑（Pre-RA）
    fn run_decision_only_mode(&mut self, function: &LirFunction, analyses: &mut AnalysisManager) -> PassResult {
        println!("🚀 运行 Pre-RA 决策模式 for function: {}", function.name);
        
        // 1. 运行CFG分析
        let mut cfg_analysis = crate::pass::analysis::ControlFlowAnalysis::new();
        let cfg_result = match cfg_analysis.analyze_function(function, analyses) {
            Ok(result) => result,
            Err(e) => {
                eprintln!("🚨 CFG分析失败: {}", e);
                // 回退到简单分析
                let lifetimes = self.analyze_lifetimes(function);
                let allocation_result = self.perform_linear_scan(lifetimes, function);
                return self.store_decision_result(function, allocation_result, analyses);
            }
        };
        
        let cfg = cfg_result.as_any().downcast_ref::<crate::pass::analysis::ControlFlowGraph>()
            .expect("CFG分析结果类型不匹配");
        
        // 2. 运行DefUse分析
        let mut def_use_analysis = crate::pass::analysis::DefUseAnalysis::new();
        let def_use_result = match def_use_analysis.analyze_function(function, analyses) {
            Ok(result) => result,
            Err(e) => {
                eprintln!("🚨 DefUse分析失败: {}", e);
                // 回退到简单分析
                let lifetimes = self.analyze_lifetimes(function);
                let allocation_result = self.perform_linear_scan(lifetimes, function);
                return self.store_decision_result(function, allocation_result, analyses);
            }
        };
        
        let def_use = def_use_result.as_any().downcast_ref::<crate::pass::analysis::DefUseChains>()
            .expect("DefUse分析结果类型不匹配");
        
        // 3. 使用CFG和DefUse进行精确生命周期分析
        let lifetimes = self.analyze_lifetimes_with_cfg(function, cfg, def_use);
        
        // 4. 执行寄存器分配决策（不修改函数）
        let allocation_result = self.perform_linear_scan(lifetimes, function);
        
        // 5. 存储决策结果
        self.store_decision_result(function, allocation_result, analyses)
    }
    
    /// 🔧 新增：最终改写模式运行逻辑（Final-RA）
    fn run_final_rewrite_mode(&mut self, function: &mut LirFunction, analyses: &mut AnalysisManager) -> PassResult {
        println!("🚀 运行 Final-RA 改写模式 for function: {}", function.name);
        
        // 1. 运行CFG分析
        let mut cfg_analysis = crate::pass::analysis::ControlFlowAnalysis::new();
        let cfg_result = match cfg_analysis.analyze_function(function, analyses) {
            Ok(result) => result,
            Err(e) => {
                eprintln!("🚨 CFG分析失败: {}", e);
                // 回退到简单分析
                let lifetimes = self.analyze_lifetimes(function);
                let allocation_result = self.perform_linear_scan(lifetimes, function);
                return self.apply_and_return_result(function, allocation_result, analyses);
            }
        };
        
        let cfg = cfg_result.as_any().downcast_ref::<crate::pass::analysis::ControlFlowGraph>()
            .expect("CFG分析结果类型不匹配");
        
        // 2. 运行DefUse分析
        let mut def_use_analysis = crate::pass::analysis::DefUseAnalysis::new();
        let def_use_result = match def_use_analysis.analyze_function(function, analyses) {
            Ok(result) => result,
            Err(e) => {
                eprintln!("🚨 DefUse分析失败: {}", e);
                // 回退到简单分析
                let lifetimes = self.analyze_lifetimes(function);
                let allocation_result = self.perform_linear_scan(lifetimes, function);
                return self.apply_and_return_result(function, allocation_result, analyses);
            }
        };
        
        let def_use = def_use_result.as_any().downcast_ref::<crate::pass::analysis::DefUseChains>()
            .expect("DefUse分析结果类型不匹配");
        
        // 3. 使用CFG和DefUse进行精确生命周期分析
        let lifetimes = self.analyze_lifetimes_with_cfg(function, cfg, def_use);
        
        // 4. 执行寄存器分配
        let allocation_result = self.perform_linear_scan(lifetimes, function);
        
        // 5. 应用结果并修改函数
        self.apply_and_return_result(function, allocation_result, analyses)
    }
    
    /// 🔧 新增：存储决策结果（不修改函数）
    fn store_decision_result(
        &self, 
        function: &LirFunction, 
        allocation_result: RegisterAllocationResult, 
        analyses: &mut AnalysisManager
    ) -> PassResult {
        println!("Pre-RA 决策完成: {} 个虚拟寄存器, {} 个需要溢出", 
                allocation_result.stats.total_virtual_registers,
                allocation_result.stats.spilled_registers);
        
        // 存储决策结果供 StackFrameLowering 使用
        analyses.store_result(
            format!("pre-ra-decision-{}", function.name),
            Box::new(allocation_result)
        );
        
        PassResult::Changed
    }

    /// 获取可分配的物理寄存器列表
    fn get_available_physical_registers(&self) -> Vec<u8> {
        // 🔧 修复：确保保留的寄存器不会被分配
        let mut available = Vec::new();
        
        // 虚拟机有8个寄存器：r0-r7
        for reg_id in 0..8 {
            if !self.reserved_registers.contains(&reg_id) {
                available.push(reg_id);
            }
        }
        
        // 🔧 调试：输出可分配寄存器
        println!("🔧 可分配的物理寄存器: {:?}", available);
        println!("🔧 保留的寄存器: {:?}", self.reserved_registers);
        
        available
    }
}

impl FunctionPass for LinearScanRegisterAllocation {
    fn name(&self) -> &str {
        "linear-scan-register-allocation"
    }
    
    fn run_on_function(&mut self, function: &mut LirFunction, analyses: &mut AnalysisManager) -> PassResult {
        match self.mode {
            RegisterAllocationMode::DecisionOnly => {
                // 需要转换为不可变引用
                let function_ref = function as &LirFunction;
                self.run_decision_only_mode(function_ref, analyses)
            }
            RegisterAllocationMode::FinalRewrite => {
                self.run_final_rewrite_mode(function, analyses)
            }
        }
    }
    
    fn required_analyses(&self) -> Vec<&'static str> {
        vec![] // 我们按需运行分析
    }
    
    fn invalidated_analyses(&self) -> Vec<&'static str> {
        vec![] // 不使其他分析失效
    }
}

impl Default for LinearScanRegisterAllocation {
    fn default() -> Self {
        Self::new()
    }
} 