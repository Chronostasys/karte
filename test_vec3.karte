struct Vec3 {
    x: number,
    y: number,
    z: number
}

fn cross(a: Vec3, b: Vec3) -> Vec3 {
    Vec3 {
        x: a.y * b.z - a.z * b.y,
        y: a.z * b.x - a.x * b.z,
        z: a.x * b.y - a.y * b.x
    }
}

fn dot(a: Vec3, b: Vec3) -> number {
    a.x * b.x + a.y * b.y + a.z * b.z
}

fn main() -> number {
    let a = Vec3 { x: 1, y: 0, z: 0 };
    let b = Vec3 { x: 0, y: 1, z: 0 };
    let c = cross(a, b);
    dot(c, Vec3 { x: 0, y: 0, z: 1 })
}
