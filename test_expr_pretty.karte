enum Expr {
    Num(number),
    Add(Expr, Expr),
    Mul(Expr, Expr),
    Neg(Expr)
}

fn eval(e: Expr) -> number {
    match e {
        Num(n) => n,
        Add(a, b) => eval(a) + eval(b),
        Mul(a, b) => eval(a) * eval(b),
        Neg(x) => 0 - eval(x)
    }
}

fn expr_to_string(e: Expr) -> string {
    match e {
        Num(n) if n < 0 => "(" + to_string(n) + ")",
        Num(n) => to_string(n),
        Add(a, b) => "(" + expr_to_string(a) + " + " + expr_to_string(b) + ")",
        Mul(a, b) => "(" + expr_to_string(a) + " * " + expr_to_string(b) + ")",
        Neg(x) => "(-" + expr_to_string(x) + ")"
    }
}

fn main() -> number {
    let e = Add(Num(3), Mul(Neg(Num(5)), Num(4)));
    let result = eval(e);
    print(expr_to_string(e) + " = " + to_string(result) + "\n");
    result
}
