enum Option {
    Some(number),
    None
}

fn maybe_add(a: Option, b: Option) -> number {
    match a {
        Some(x) => match b {
            Some(y) => x + y,
            None => x
        },
        None => match b {
            Some(y) => y,
            None => 0
        }
    }
}

fn main() -> number {
    maybe_add(Some(10), Some(20)) + maybe_add(Some(5), None) + maybe_add(None, Some(3)) + maybe_add(None, None)
}
