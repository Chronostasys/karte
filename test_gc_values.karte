fn gc_init() -> number {
    let heap = runtime_heap_base();
    let bump_start = heap + 24;
    unsafe_store(heap, bump_start);
    unsafe_store(heap + 8, 0);
    unsafe_store(heap + 16, 256);
    heap
}

fn gc_alloc(size: number) -> number {
    let heap = runtime_heap_base();
    let bump = unsafe_load(heap);
    let align_mask = 0 - 16;
    let total_size = (size + 16 + 15) bitand align_mask;
    let new_bump = bump + total_size;
    let heap_limit = runtime_heap_limit();
    if new_bump >= heap_limit {
        gc_collect();
        let new_bump2 = unsafe_load(heap) + total_size;
        if new_bump2 >= heap_limit {
            0
        } else {
            let bump2 = unsafe_load(heap);
            unsafe_store(heap, new_bump2);
            unsafe_store(bump2, 0);
            unsafe_store(bump2 + 8, total_size);
            bump2 + 16
        }
    } else {
        let alloc_count = unsafe_load(heap + 8);
        let new_count = alloc_count + 1;
        unsafe_store(heap + 8, new_count);
        let threshold = unsafe_load(heap + 16);
        unsafe_store(heap, new_bump);
        unsafe_store(bump, 0);
        unsafe_store(bump + 8, total_size);
        if new_count >= threshold {
            gc_collect()
        } else {
            0
        };
        bump + 16
    }
}

fn gc_is_valid_obj(obj: number, heap: number) -> number {
    let bump = unsafe_load(heap);
    let ptr = heap + 24;
    let found = 0;
    while ptr < bump {
        let total_size = unsafe_load(ptr + 8);
        if total_size < 16 {
            ptr = bump
        } else {
            let data_start = ptr + 16;
            if obj == data_start {
                found = 1;
                ptr = bump
            } else {
                ptr = ptr + total_size
            }
        }
    };
    found
}

fn gc_mark(obj: number, heap: number, heap_limit: number) -> number {
    if obj < heap + 24 {
        0
    } else {
        if obj >= heap_limit {
            0
        } else {
            let header_ptr = obj - 16;
            let header = unsafe_load(header_ptr);
            if header bitand 1 != 0 {
                0
            } else {
                unsafe_store(header_ptr, header bitor 1);
                let size_field = unsafe_load(header_ptr + 8);
                let data_size = size_field - 16;
                let i = 0;
                while i < data_size {
                    let field = unsafe_load(obj + i);
                    if field >= heap + 24 {
                        if field < heap_limit {
                            gc_mark(field, heap, heap_limit)
                        } else {
                            0
                        }
                    } else {
                        0
                    };
                    i = i + 8
                };
                0
            }
        }
    }
}

fn gc_sweep(heap: number) -> number {
    let bump = unsafe_load(heap);
    let ptr = heap + 24;
    let new_bump = heap + 24;
    while ptr < bump {
        let total_size = unsafe_load(ptr + 8);
        if total_size < 16 {
            ptr = bump
        } else {
            let header = unsafe_load(ptr);
            let marked = header bitand 1;
            if marked != 0 {
                unsafe_store(ptr, header bitand (0 - 2));
                new_bump = ptr + total_size;
                ptr = ptr + total_size
            } else {
                ptr = ptr + total_size
            }
        }
    };
    unsafe_store(heap, new_bump);
    unsafe_store(heap + 8, 0);
    new_bump
}

fn gc_collect() -> number {
    let heap = runtime_heap_base();
    let heap_limit = runtime_heap_limit();
    let stack_bottom = runtime_stack_bottom();
    let vm_sp = runtime_vm_sp();
    let scan = stack_bottom;
    while scan < vm_sp {
        let val = unsafe_load(scan);
        if val >= heap + 24 {
            if val < heap_limit {
                if gc_is_valid_obj(val, heap) != 0 {
                    gc_mark(val, heap, heap_limit)
                } else {
                    0
                }
            } else {
                0
            }
        } else {
            0
        };
        scan = scan + 8
    };
    gc_sweep(heap)
}

fn main() -> number {
    let state = gc_init();
    let p1 = gc_alloc(8);
    unsafe_store(p1, 10);
    let p2 = gc_alloc(8);
    unsafe_store(p2, 20);
    let p3 = gc_alloc(16);
    unsafe_store(p3, 30);
    unsafe_store(p3 + 8, 40);
    gc_collect();
    let p4 = gc_alloc(8);
    unsafe_store(p4, 50);
    unsafe_load(p1) + unsafe_load(p2) + unsafe_load(p3) + unsafe_load(p3 + 8) + unsafe_load(p4)
}
