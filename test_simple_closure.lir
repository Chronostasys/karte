functions: {
    simple_lambda:
        LirFunction
        name: simple_lambda
        body:
        [
            Label(L1),
            mov dst: #p0, src: # value: 42,
            Return(#p0)
        ]
        params: 0,

    main:
        LirFunction
        name: main
        body:
        [
            Label(L2),
            Call(@ id: L1),
            Return(#p0)
        ]
        params: 0
    }, main_function: main, global_struct_types: {}, global_variables: {}
