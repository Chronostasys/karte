struct Student {
    name: string,
    score: number
}

fn get_grade(score: number) -> string {
    if score >= 90 {
        "A"
    } else {
        "F"
    }
}

fn main() -> number {
    let s1 = Student { name: "Alice", score: 95 };
    let s2 = Student { name: "Bob", score: 72 };
    let g1 = get_grade(s1.score);
    let g2 = get_grade(s2.score);
    print(s1.name + ": " + g1 + "\n");
    print(s2.name + ": " + g2 + "\n");
    0
}
