enum Tree {
    Leaf,
    Node(number, Tree, Tree)
}

fn tree_sum(t: Tree) -> number {
    match t {
        Leaf => 0,
        Node(v, l, r) => v + tree_sum(l) + tree_sum(r)
    }
}

fn max(a: number, b: number) -> number {
    if a > b { a } else { b }
}

fn tree_depth(t: Tree) -> number {
    match t {
        Leaf => 0,
        Node(v, l, r) => 1 + max(tree_depth(l), tree_depth(r))
    }
}

fn main() -> number {
    let t = Node(1, Node(2, Node(3, Leaf, Leaf), Leaf), Node(4, Leaf, Node(5, Leaf, Leaf)));
    tree_sum(t) + tree_depth(t)
}
