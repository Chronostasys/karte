fn map(f: number -> number, n: number) -> number {
    f(n)
}

fn filter(pred: number -> bool, n: number) -> number {
    if pred(n) { n } else { 0 }
}

fn main() -> number {
    let double = |x| { x * 2 };
    let is_positive = |x| { x > 0 };
    let result = map(double, 5);
    let filtered = filter(is_positive, result);
    filtered
}
