struct Student {
    name: string,
    score: number
}

fn make_student(name: string, score: number) -> Student {
    Student { name: name, score: score }
}

fn main() -> number {
    let s1 = make_student("Alice", 95);
    let s2 = make_student("Bob", 72);
    print(s1.name);
    print(s2.name);
    0
}
