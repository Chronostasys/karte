struct Student {
    name: string,
    score: number
}

fn get_grade(s: Student) -> string {
    let score = s.score;
    if score >= 90 {
        "A"
    } else {
        "F"
    }
}

fn main() -> number {
    let s1 = Student { name: "Alice", score: 95 };
    let s2 = Student { name: "Bob", score: 72 };
    let g1 = get_grade(s1);
    let g2 = get_grade(s2);
    print(s1.name + ": " + g1 + "\n");
    print(s2.name + ": " + g2 + "\n");
    0
}
