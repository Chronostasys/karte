module main

fn main() -> number {
    let src = "int main() { int a; a = 10; int b; b = 20; int c; if (a < b) { c = a; } else { c = b; }; return c; }";
    let out = cc(src);
    print(out);
    0
}

fn cc(src: string) -> string {
    let tk = tokenize(src);
    let tn = count_tk(tk);
    let hdr = ".globl _start\n_start:\n  call main\n  mov %rax, %rdi\n  mov $60, %rax\n  syscall\n";
    let r = compile_fn(0, tk, tn, hdr, 0);
    r.1
}

fn skip_lbrace_inner(pos: number, tk: string) -> number {
    let k = tk_kind(tk, pos);
    if k == 4 { pos + 1 } else { pos }
}

fn skip_lbrace(pos: number, tk: string) -> number {
    let i = pos;
    let m = 1;
    let n = count_tk(tk);
    while m == 1 {
        if i >= n { m = 0; 0 } else {
            if tk_kind(tk, i) == 4 { m = 0; 0 } else { i += 1; 0 }
        }
    };
    i + 1
}

fn compile_fn(pos: number, tk: string, tn: number, asm: string, lc: number) -> (number, string, number) {
    let name = tk_val(tk, pos);
    let a = asm + name + ":\n  push %rbp\n  mov %rsp, %rbp\n  sub $208, %rsp\n";
    let s = (skip_lbrace(pos, tk), a, lc, "", 0);
    let d = 0;
    while d == 0 {
        let k = tk_kind(tk, s.0);
        if k == 8 { d = 1; 0 } else {
            if k == 5 { s = (s.0 + 1, s.1, s.2, s.3, s.4); 0 } else {
                s = do_stmt(s, tk, tn, k); 0
            }
        }
    };
    (s.0 + 1, s.1 + "  leave\n  ret\n", s.2)
}

fn do_stmt(s: (number, string, number, string, number), tk: string, tn: number, k: number) -> (number, string, number, string, number) {
    if k == 1 {
        let nm = tk_val(tk, s.0 + 1);
        (s.0 + 3, s.1, s.2, s.3 + nm + ":" + to_string(s.4) + ",", s.4 + 1)
    } else {
        if k == 20 {
            let e = expr((s.0 + 1, s.1, s.2, s.3, s.4), tk, tn);
            (e.0 + 1, e.1 + "  pop %rax\n  leave\n  ret\n", e.2, e.3, e.4)
        } else {
            if k == 19 { do_if(s, tk, tn) } else {
                if k == 21 { do_while(s, tk, tn) } else { do_asgn(s, tk, tn) }
            }
        }
    }
}

fn do_body(s: (number, string, number, string, number), tk: string, tn: number) -> (number, string, number, string, number) {
    let r = (skip_lbrace_inner(s.0, tk), s.1, s.2, s.3, s.4);
    let d = 0;
    while d == 0 {
        let k = tk_kind(tk, r.0);
        if k == 8 { d = 1; 0 } else {
            if k == 5 { r = (r.0 + 1, r.1, r.2, r.3, r.4); 0 } else {
                if k == 20 {
                    let e = expr((r.0 + 1, r.1, r.2, r.3, r.4), tk, tn);
                    r = (e.0 + 1, e.1 + "  pop %rax\n  leave\n  ret\n", e.2, e.3, e.4);
                    d = 1;
                    0
                } else { r = do_stmt(r, tk, tn, k); 0 }
            }
        }
    };
    r
}

fn do_if(s: (number, string, number, string, number), tk: string, tn: number) -> (number, string, number, string, number) {
    let e = expr((s.0 + 2, s.1, s.2, s.3, s.4), tk, tn);
    let el = e.2;
    let endl = el + 1;
    let a = e.1 + "  pop %rax\n  cmp $0, %rax\n  je .L" + to_string(el) + "\n";
    let b = do_body((e.0 + 1, a, endl, e.3, e.4), tk, tn);
    a = b.1 + "  jmp .L" + to_string(endl) + "\n.L" + to_string(el) + ":\n";
    let nk = tk_kind(tk, b.0 + 1);
    if nk == 22 {
        let c = do_body((b.0 + 3, a, b.2, b.3, b.4), tk, tn);
        (c.0 + 1, c.1 + ".L" + to_string(endl) + ":\n", c.2, c.3, c.4)
    } else {
        (b.0 + 1, a + ".L" + to_string(endl) + ":\n", b.2, b.3, b.4)
    }
}

fn do_while(s: (number, string, number, string, number), tk: string, tn: number) -> (number, string, number, string, number) {
    let sl = s.2;
    let endl = sl + 1;
    let a = s.1 + ".L" + to_string(sl) + ":\n";
    let e = expr((s.0 + 2, a, endl, s.3, s.4), tk, tn);
    a = e.1 + "  pop %rax\n  cmp $0, %rax\n  je .L" + to_string(endl) + "\n";
    let b = do_body((e.0 + 1, a, e.2, e.3, e.4), tk, tn);
    (b.0 + 1, b.1 + "  jmp .L" + to_string(sl) + "\n.L" + to_string(endl) + ":\n", b.2, b.3, b.4)
}

fn do_asgn(s: (number, string, number, string, number), tk: string, tn: number) -> (number, string, number, string, number) {
    let nm = tk_val(tk, s.0);
    let off = var_off(s.3, nm);
    let e = expr((s.0 + 2, s.1, s.2, s.3, s.4), tk, tn);
    (e.0 + 1, e.1 + "  pop %rax\n  mov %rax, " + to_string(0 - (off + 1) * 8) + "(%rbp)\n", e.2, e.3, e.4)
}

fn expr(s: (number, string, number, string, number), tk: string, tn: number) -> (number, string, number, string, number) { p_add(s, tk, tn) }

fn p_add(s: (number, string, number, string, number), tk: string, tn: number) -> (number, string, number, string, number) {
    let r = p_mul(s, tk, tn);
    let m = 1;
    let cur = r;
    while m == 1 {
        if cur.0 >= tn { m = 0; 0 } else {
            let k = tk_kind(tk, cur.0);
            if k == 15 {
                let r2 = p_mul((cur.0 + 1, cur.1, cur.2, cur.3, cur.4), tk, tn);
                cur = (r2.0, r2.1 + "  pop %rcx\n  pop %rax\n  add %rcx, %rax\n  push %rax\n", r2.2, r2.3, r2.4);
                0
            } else {
                if k == 16 {
                    let r2 = p_mul((cur.0 + 1, cur.1, cur.2, cur.3, cur.4), tk, tn);
                    cur = (r2.0, r2.1 + "  pop %rcx\n  pop %rax\n  sub %rcx, %rax\n  push %rax\n", r2.2, r2.3, r2.4);
                    0
                } else { m = 0; 0 }
            }
        }
    };
    cur
}

fn p_mul(s: (number, string, number, string, number), tk: string, tn: number) -> (number, string, number, string, number) {
    let r = p_unary(s, tk, tn);
    let m = 1;
    let cur = r;
    while m == 1 {
        if cur.0 >= tn { m = 0; 0 } else {
            let k = tk_kind(tk, cur.0);
            if k == 17 {
                let r2 = p_unary((cur.0 + 1, cur.1, cur.2, cur.3, cur.4), tk, tn);
                cur = (r2.0, r2.1 + "  pop %rcx\n  pop %rax\n  imul %rcx, %rax\n  push %rax\n", r2.2, r2.3, r2.4);
                0
            } else {
                if k == 18 {
                    let r2 = p_unary((cur.0 + 1, cur.1, cur.2, cur.3, cur.4), tk, tn);
                    cur = (r2.0, r2.1 + "  pop %rcx\n  pop %rax\n  cqto\n  idiv %rcx\n  push %rax\n", r2.2, r2.3, r2.4);
                    0
                } else { m = 0; 0 }
            }
        }
    };
    cur
}

fn p_unary(s: (number, string, number, string, number), tk: string, tn: number) -> (number, string, number, string, number) {
    let k = tk_kind(tk, s.0);
    if k == 16 {
        let r = p_unary((s.0 + 1, s.1, s.2, s.3, s.4), tk, tn);
        (r.0, r.1 + "  pop %rax\n  neg %rax\n  push %rax\n", r.2, r.3, r.4)
    } else { p_cmp(s, tk, tn) }
}

fn p_cmp(s: (number, string, number, string, number), tk: string, tn: number) -> (number, string, number, string, number) {
    let r = p_primary(s, tk, tn);
    if r.0 >= tn { r } else {
        let k = tk_kind(tk, r.0);
        if k == 9 { cmp_op(r, tk, tn, "sete") } else {
            if k == 11 { cmp_op(r, tk, tn, "setl") } else {
                if k == 13 { cmp_op(r, tk, tn, "setg") } else { r }
            }
        }
    }
}

fn cmp_op(r: (number, string, number, string, number), tk: string, tn: number, op: string) -> (number, string, number, string, number) {
    let r2 = p_primary((r.0 + 1, r.1, r.2, r.3, r.4), tk, tn);
    (r2.0, r2.1 + "  pop %rcx\n  pop %rax\n  cmp %rcx, %rax\n  " + op + " %al\n  movzx %al, %rax\n  push %rax\n", r2.2, r2.3, r2.4)
}

fn p_primary(s: (number, string, number, string, number), tk: string, tn: number) -> (number, string, number, string, number) {
    let k = tk_kind(tk, s.0);
    if k == 2 {
        let v = tk_num(tk, s.0);
        (s.0 + 1, s.1 + "  push $" + to_string(v) + "\n", s.2, s.3, s.4)
    } else {
        if k == 3 {
            let nm = tk_val(tk, s.0);
            let off = var_off(s.3, nm);
            (s.0 + 1, s.1 + "  mov " + to_string(0 - (off + 1) * 8) + "(%rbp), %rax\n  push %rax\n", s.2, s.3, s.4)
        } else {
            if k == 6 {
                let r = expr((s.0 + 1, s.1, s.2, s.3, s.4), tk, tn);
                (r.0 + 1, r.1, r.2, r.3, r.4)
            } else { (s.0 + 1, s.1 + "  push $0\n", s.2, s.3, s.4) }
        }
    }
}

fn tokenize(src: string) -> string {
    let n = len(src);
    let out = "";
    let i = 0;
    while i < n {
        let c = str_index(src, i);
        let adv = 0;
        if c == 32 || c == 10 || c == 13 || c == 9 { adv = 1; i += 1; 0 } else { 0 };
        if adv == 0 && c == 40 { out = out + "6:0:0:(|"; adv = 1; i += 1; 0 } else { 0 };
        if adv == 0 && c == 41 { out = out + "7:0:0:)|"; adv = 1; i += 1; 0 } else { 0 };
        if adv == 0 && c == 123 { out = out + "4:0:0:{|"; adv = 1; i += 1; 0 } else { 0 };
        if adv == 0 && c == 125 { out = out + "8:0:0:}|"; adv = 1; i += 1; 0 } else { 0 };
        if adv == 0 && c == 59 { out = out + "5:0:0:;|"; adv = 1; i += 1; 0 } else { 0 };
        if adv == 0 && c == 43 { out = out + "15:0:0:+|"; adv = 1; i += 1; 0 } else { 0 };
        if adv == 0 && c == 45 { out = out + "16:0:0:-|"; adv = 1; i += 1; 0 } else { 0 };
        if adv == 0 && c == 42 { out = out + "17:0:0:*|"; adv = 1; i += 1; 0 } else { 0 };
        if adv == 0 && c == 47 { out = out + "18:0:0:/|"; adv = 1; i += 1; 0 } else { 0 };
        if adv == 0 && c == 61 {
            if i + 1 < n {
                if str_index(src, i + 1) == 61 { out = out + "9:0:0:==|"; i += 2 } else { out = out + "23:0:0:=|"; i += 1 }
            } else { out = out + "23:0:0:=|"; i += 1 };
            adv = 1;
            0
        } else { 0 };
        if adv == 0 && c == 60 {
            if i + 1 < n {
                if str_index(src, i + 1) == 61 { out = out + "12:0:0:<=|"; i += 2 } else { out = out + "11:0:0:<|"; i += 1 }
            } else { out = out + "11:0:0:<|"; i += 1 };
            adv = 1;
            0
        } else { 0 };
        if adv == 0 && c == 62 {
            if i + 1 < n {
                if str_index(src, i + 1) == 61 { out = out + "14:0:0:>=|"; i += 2 } else { out = out + "13:0:0:>|"; i += 1 }
            } else { out = out + "13:0:0:>|"; i += 1 };
            adv = 1;
            0
        } else { 0 };
        if adv == 0 && c == 33 {
            if i + 1 < n {
                if str_index(src, i + 1) == 61 { out = out + "10:0:0:!=|"; i += 2 } else { i += 1 }
            } else { i += 1 };
            adv = 1;
            0
        } else { 0 };
        if adv == 0 && is_d(c) == 1 {
            let v = 0;
            let m = 1;
            while m == 1 {
                if i >= n { m = 0; 0 } else {
                    let c2 = str_index(src, i);
                    if is_d(c2) == 1 { v = v * 10 + (c2 - 48); i += 1; 0 } else { m = 0; 0 }
                }
            };
            out = out + "2:0:" + to_string(v) + ":" + to_string(v) + "|";
            adv = 1;
            0
        } else { 0 };
        if adv == 0 && is_a(c) == 1 {
            let start = i;
            let m = 1;
            while m == 1 {
                if i >= n { m = 0; 0 } else {
                    let c2 = str_index(src, i);
                    if is_an(c2) == 1 { i += 1; 0 } else { m = 0; 0 }
                }
            };
            let w = sub(src, start, i);
            let kw = keyword(w);
            out = out + to_string(kw) + ":0:0:" + w + "|";
            adv = 1;
            0
        } else { 0 };
        if adv == 0 { i += 1; 0 } else { 0 }
    };
    out
}

fn is_d(c: number) -> number { if c >= 48 { if c <= 57 { 1 } else { 0 } } else { 0 } }
fn is_a(c: number) -> number {
    if c >= 65 { if c <= 90 { 1 } else {
        if c >= 97 { if c <= 122 { 1 } else { if c == 95 { 1 } else { 0 } } } else { if c == 95 { 1 } else { 0 } }
    } } else { if c == 95 { 1 } else { 0 } }
}
fn is_an(c: number) -> number { let a = is_a(c); if a == 1 { 1 } else { is_d(c) } }
fn keyword(w: string) -> number {
    if eq(w, "int") == 1 { 1 } else {
        if eq(w, "return") == 1 { 20 } else {
            if eq(w, "if") == 1 { 19 } else {
                if eq(w, "else") == 1 { 22 } else {
                    if eq(w, "while") == 1 { 21 } else { 3 }
                }
            }
        }
    }
}

fn tk_kind(tk: string, i: number) -> number {
    let p = nth_pipe(tk, i);
    if p == -1 { 0 } else { pn(tk, p + 1, find_c(tk, p + 1)) }
}
fn tk_val(tk: string, i: number) -> string {
    let p = nth_pipe(tk, i);
    if p == -1 { "" } else {
        let c1 = find_c(tk, p + 1);
        let c2 = find_c(tk, c1 + 1);
        let c3 = find_c(tk, c2 + 1);
        let end = find_p(tk, c3 + 1);
        sub(tk, c3 + 1, end)
    }
}
fn tk_num(tk: string, i: number) -> number {
    let p = nth_pipe(tk, i);
    if p == -1 { 0 } else {
        let c1 = find_c(tk, p + 1);
        let c2 = find_c(tk, c1 + 1);
        let c3 = find_c(tk, c2 + 1);
        pn(tk, c2 + 1, c3)
    }
}
fn count_tk(tk: string) -> number {
    let n = len(tk);
    let c = 0;
    let i = 0;
    while i < n {
        if str_index(tk, i) == 124 { c += 1 };
        i += 1
    };
    c
}
fn nth_pipe(s: string, n: number) -> number {
    let i = 0;
    let c = 0;
    let len_s = len(s);
    let f = -1;
    let m = 1;
    while m == 1 {
        if i >= len_s { m = 0; 0 } else {
            if str_index(s, i) == 124 {
                if c == n { f = i; m = 0; 0 } else { c += 1; i += 1; 0 }
            } else { i += 1; 0 }
        }
    };
    f
}
fn find_c(s: string, start: number) -> number {
    let i = start;
    let n = len(s);
    let f = n;
    let m = 1;
    while m == 1 { if i >= n { m = 0; 0 } else { if str_index(s, i) == 58 { f = i; m = 0; 0 } else { i += 1; 0 } } };
    f
}
fn find_p(s: string, start: number) -> number {
    let i = start;
    let n = len(s);
    let f = n;
    let m = 1;
    while m == 1 { if i >= n { m = 0; 0 } else { if str_index(s, i) == 124 { f = i; m = 0; 0 } else { i += 1; 0 } } };
    f
}
fn sub(s: string, a: number, b: number) -> string {
    let r = "";
    let i = a;
    while i < b { r = r + char_to_string(str_index(s, i)); i += 1 };
    r
}
fn pn(s: string, a: number, b: number) -> number {
    let v = 0;
    let i = a;
    let m = 1;
    while m == 1 {
        if i >= b { m = 0; 0 } else {
            let c = str_index(s, i);
            if c >= 48 { if c <= 57 { v = v * 10 + (c - 48); i += 1; 0 } else { m = 0; 0 } } else { m = 0; 0 }
        }
    };
    v
}
fn var_off(vm: string, name: string) -> number {
    let vl = len(vm);
    let start = 0;
    let f = -1;
    let m = 1;
    while m == 1 {
        if start >= vl { m = 0; 0 } else {
            let colon = find_c(vm, start);
            let comma = find_ch(vm, colon + 1, 44);
            if comma == -1 { m = 0; 0 } else {
                let entry = sub(vm, start, colon);
                if eq(entry, name) == 1 { f = pn(vm, colon + 1, comma); m = 0; 0 } else { start = comma + 1; 0 }
            }
        }
    };
    if f == -1 { 0 } else { f }
}
fn find_ch(s: string, start: number, ch: number) -> number {
    let i = start;
    let n = len(s);
    let f = -1;
    let m = 1;
    while m == 1 { if i >= n { m = 0; 0 } else { if str_index(s, i) == ch { f = i; m = 0; 0 } else { i += 1; 0 } } };
    f
}
fn eq(a: string, b: string) -> number {
    let la = len(a);
    let lb = len(b);
    if la != lb { 0 } else {
        let i = 0;
        let ok = 1;
        let m = 1;
        while m == 1 { if i >= la { m = 0; 0 } else { if str_index(a, i) != str_index(b, i) { ok = 0; m = 0; 0 } else { i += 1; 0 } } };
        ok
    }
}
