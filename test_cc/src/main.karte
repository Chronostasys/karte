module main

enum Tk {
    Num(number),
    Id(string),
    Kw(number),
    Sym(number),
    Eof
}

struct Label { start: string, end: string, next: number }

fn emit(s: string) -> number { print(s + "\n"); 0 }

fn main() -> number {
    let buf = gc_alloc(65536 + 8);
    let n = sys_read(0, buf + 8, 65535);
    if n <= 0 {
        print("error: no input\n");
        1
    } else {
        mem_store64(buf, n);
        compile(unsafe_cast(buf), 0, n)
    }
}

fn compile(src: string, pos: number, end: number) -> number {
    let state = pos;
    let globals = "";
    let r1 = while state < end {
        let tk = peek(src, state, end);
        if match tk { Tk::Kw(1) => true, Tk::Kw(44) => true, _ => false } {
            state = advance(src, state, end);
            let name = token_val(src, state, end);
            state = advance(src, state, end);
            let nxt = peek(src, state, end);
            if match nxt { Tk::Sym(6) => true, _ => false } {
                state = advance(src, state, end);
                let depth = 1;
                let r1a = while state < end && depth > 0 {
                    let t = peek(src, state, end);
                    if match t { Tk::Sym(6) => true, _ => false } {
                        depth = depth + 1
                    } else if match t { Tk::Sym(7) => true, _ => false } {
                        depth = depth - 1
                    };
                    state = advance(src, state, end);
                    0
                };
                let depth2 = 0;
                let r1b = while state < end {
                    let t = peek(src, state, end);
                    if match t { Tk::Sym(4) => true, _ => false } {
                        depth = depth + 1
                    } else if match t { Tk::Sym(8) => true, _ => false } {
                        depth = depth - 1;
                        if depth == 0 { break; 0 } else { 0 }
                    };
                    state = advance(src, state, end);
                    0
                };
                state = advance(src, state, end)
            } else {
                let init_val = 0;
                if match nxt { Tk::Sym(10) => true, _ => false } {
                    state = advance(src, state, end);
                    init_val = match peek(src, state, end) {
                        Tk::Num(n) => n,
                        _ => 0
                    };
                    state = advance(src, state, end)
                };
                globals = globals + name + ":" + to_string(init_val) + ",";
                state = advance(src, state, end)
            }
        } else {
            state = advance(src, state, end)
        }
    };
    if len(globals) > 0 {
        emit(".data")
    };
    let gp = 0;
    let glen = len(globals);
    let r2 = while gp < glen {
        let cp = find_ch(globals, gp, 58);
        let gn = sub_str(globals, gp, cp);
        let vp = cp + 1;
        let np = find_ch(globals, vp, 44);
        let gv = pn(globals, vp, np);
        emit(".globl " + gn);
        emit(gn + ":");
        emit("  .quad " + to_string(gv));
        gp = np + 1;
        0
    };
    emit(".text");
    emit(".globl _start");
    emit("_start:");
    emit("  call main");
    emit("  mov %rax, %rdi");
    emit("  mov $60, %rax");
    emit("  syscall");
    state = pos;
    let lc = 0;
    let func_count = 0;
    let r = while state < end {
        match peek(src, state, end) {
            Tk::Kw(1) | Tk::Kw(44) => {
                let save2 = state;
                state = advance(src, state, end);
                let name2 = token_val(src, state, end);
                state = advance(src, state, end);
                let nxt2 = peek(src, state, end);
                if match nxt2 { Tk::Sym(6) => true, _ => false } {
                    state = save2;
                    let func = parse_func(src, state, end, lc);
                    emit_func(func.0, func.1);
                    let end_lbl = ".LFE" + to_string(func_count);
                    let body = do_block(src, func.2, end, func.3, lc + func.1 * 10, end_lbl, "", "");
                    emit(end_lbl + ":");
                    emit("  leave");
                    emit("  ret");
                    state = skip_matching(src, func.2, end) + 1;
                    lc = body.2;
                    func_count = func_count + 1
                } else {
                    if match nxt2 { Tk::Sym(10) => true, _ => false } {
                        state = advance(src, state, end);
                        state = advance(src, state, end)
                    };
                    state = advance(src, state, end)
                }
            },
            Tk::Kw(43) => {
                let func = parse_func(src, state, end, lc);
                emit_func(func.0, func.1);
                let end_lbl = ".LFE" + to_string(func_count);
                let body = do_block(src, func.2, end, func.3, lc + func.1 * 10, end_lbl, "", "");
                emit(end_lbl + ":");
                emit("  leave");
                emit("  ret");
                state = skip_matching(src, func.2, end) + 1;
                lc = body.2;
                func_count = func_count + 1
            },
            _ => { state = advance(src, state, end) }
        }
    };
    0
}

fn emit_func(name: string, argc: number) -> number {
    emit(name + ":");
    emit("  push %rbp");
    emit("  mov %rsp, %rbp");
    emit("  sub $208, %rsp");
    let i = 0;
    let r = while i < argc {
        emit("  mov " + param_reg(i) + ", " + slot(i));
        i = i + 1
    };
    0
}

fn parse_func(src: string, pos: number, end: number, lc: number) -> (string, number, number, string) {
    let s = advance(src, pos, end);
    let name = token_val(src, s, end);
    s = advance(src, s, end);
    let cp = parse_params(src, s, end);
    let argc = cp.0;
    s = cp.1;
    let vars = cp.2;
    let body_start = s;
    (name, argc, body_start, vars)
}

fn parse_params(src: string, pos: number, end: number) -> (number, number, string) {
    if match peek(src, pos, end) { Tk::Sym(7) => true, _ => false } {
        (0, advance(src, pos, end), "")
    } else {
        let vars = "";
        let c = 0;
        let s = advance(src, pos, end);
        let done2 = 0;
        let r = while done2 == 0 {
            match peek(src, s, end) {
                Tk::Sym(7) => {
                    done2 = 1;
                    s = advance(src, s, end);
                    0
                },
                Tk::Kw(1) | Tk::Kw(44) => {
                    s = advance(src, s, end);
                    let pname = token_val(src, s, end);
                    s = advance(src, s, end);
                    vars = vars + pname + ":" + to_string(c) + ",";
                    c = c + 1;
                    if match peek(src, s, end) { Tk::Sym(9) => true, _ => false } {
                        s = advance(src, s, end); 0
                    } else { 0 };
                    0
                },
                _ => { s = advance(src, s, end); 0 }
            }
        };
        (c, s, vars)
    }
}

fn param_reg(idx: number) -> string {
    match idx {
        0 => "%rdi",
        1 => "%rsi",
        2 => "%rdx",
        3 => "%rcx",
        4 => "%r8",
        _ => "%r9"
    }
}

fn slot(off: number) -> string {
    to_string(0 - (off + 1) * 8) + "(%rbp)"
}

fn store_var(name: string, off: number) -> number {
    if off >= 0 {
        emit("  mov %rax, " + slot(off))
    } else {
        emit("  movq %rax, " + name + "(%rip)")
    }
}

fn load_var(name: string, off: number) -> number {
    if off >= 0 {
        emit("  mov " + slot(off) + ", %rax")
    } else {
        emit("  movq " + name + "(%rip), %rax")
    }
}

fn make_label(lc: number) -> Label {
    Label { start: ".L" + to_string(lc), end: ".L" + to_string(lc + 1), next: lc + 2 }
}

fn do_block(src: string, pos: number, end: number, vars: string, lc: number, end_lbl: string, brk: string, cont: string) -> (number, string, number) {
    let has_brace = match peek(src, pos, end) { Tk::Sym(4) => true, _ => false };
    if !has_brace {
        let stmt = do_single_stmt(src, pos, end, vars, lc, end_lbl, brk, cont);
        (stmt.0, stmt.1, stmt.2)
    } else {
        do_block_braced(src, pos, end, vars, lc, end_lbl, brk, cont)
    }
}

fn do_block_braced(src: string, pos: number, end: number, vars: string, lc: number, end_lbl: string, brk: string, cont: string) -> (number, string, number) {
    let s = pos;
    let v = vars;
    let vc = lc;
    let done = 0;
    let returned = 0;
    let r = while done == 0 && s < end {
        match peek(src, s, end) {
            Tk::Sym(4) => {
                s = advance(src, s, end);
                0
            },
            Tk::Sym(8) => {
                done = 1;
                s = advance(src, s, end);
                0
            },
            Tk::Sym(5) => {
                s = advance(src, s, end);
                0
            },
            Tk::Kw(1) | Tk::Kw(44) => {
                s = advance(src, s, end);
                let name = token_val(src, s, end);
                s = advance(src, s, end);
                match peek(src, s, end) {
                    Tk::Sym(32) => {
                        s = advance(src, s, end);
                        let cnt = match peek(src, s, end) {
                            Tk::Num(n) => n,
                            _ => 0
                        };
                        s = advance(src, s, end);
                        s = advance(src, s, end);
                        v = v + name + ":" + to_string(vc) + ";" + to_string(cnt) + ",";
                        vc = vc + cnt;
                        0
                    },
                    _ => {
                        s = advance(src, s, end);
                        v = v + name + ":" + to_string(vc) + ",";
                        let off = vc;
                        vc = vc + 1;
                        let ep = expr(src, s, end, v);
                        s = ep;
                        emit("  pop %rax");
                        emit("  mov %rax, " + slot(off));
                        s = advance(src, s, end);
                        0
                    }
                }
            },
            Tk::Kw(20) => {
                s = advance(src, s, end);
                let ep = expr(src, s, end, v);
                emit("  pop %rax");
                emit("  jmp " + end_lbl);
                s = ep;
                s = advance(src, s, end);
                done = 1;
                returned = 1;
                0
            },
            Tk::Kw(21) => {
                let lbl = make_label(vc);
                s = advance(src, s, end);
                emit(lbl.start + ":");
                let ep = expr(src, s, end, v);
                s = ep;
                emit("  pop %rax");
                emit("  cmp $0, %rax");
                emit("  je " + lbl.end);
                let b = do_block(src, s, end, v, lbl.next, end_lbl, lbl.end, lbl.start);
                emit("  jmp " + lbl.start);
                emit(lbl.end + ":");
                s = b.0;
                v = b.1;
                vc = b.2;
                0
            },
            Tk::Kw(19) => {
                let lbl = make_label(vc);
                s = advance(src, s, end);
                let ep = expr(src, s, end, v);
                s = ep;
                emit("  pop %rax");
                emit("  cmp $0, %rax");
                emit("  je " + lbl.start);
                let b = do_block(src, s, end, v, lbl.next, end_lbl, brk, cont);
                if done == 0 {
                    emit("  jmp " + lbl.end)
                } else {
                    0
                };
                emit(lbl.start + ":");
                s = b.0;
                v = b.1;
                vc = b.2;
                let has_else = s < end && is_kw(peek(src, s, end), 22);
                if has_else {
                    s = advance(src, s, end);
                    let b2 = do_block(src, s, end, v, vc + 1, end_lbl, brk, cont);
                    emit(lbl.end + ":");
                    s = b2.0;
                    v = b2.1;
                    vc = b2.2;
                    0
                } else {
                    emit(lbl.end + ":")
                }
            },
            Tk::Kw(24) => {
                let lbl = make_label(vc);
                let cont_lbl = ".LC" + to_string(vc);
                s = advance(src, s, end);
                s = advance(src, s, end);
                let init_r = do_for_init(src, s, end, v, vc);
                s = init_r.0;
                v = init_r.1;
                vc = init_r.2;
                emit(lbl.start + ":");
                let ep = expr(src, s, end, v);
                s = ep;
                emit("  pop %rax");
                emit("  cmp $0, %rax");
                emit("  je " + lbl.end);
                s = advance(src, s, end);
                let update_start = s;
                let us = s;
                let ud = 0;
                let udone = 0;
                let rr = while udone == 0 && us < end {
                    let tk = peek(src, us, end);
                    let ic = match tk { Tk::Sym(7) => true, _ => false };
                    let io = match tk { Tk::Sym(6) => true, _ => false };
                    if ic && ud == 0 {
                        udone = 1;
                        0
                    } else {
                        if io { ud = ud + 1; 0 } else { 0 };
                        if ic { ud = ud - 1; 0 } else { 0 };
                        us = advance(src, us, end);
                        0
                    }
                };
                s = advance(src, us, end);
                let body = do_block(src, s, end, v, lbl.next, end_lbl, lbl.end, cont_lbl);
                emit(cont_lbl + ":");
                let urn = token_val(src, update_start, end);
                let uoff = var_off(v, urn);
                let uus = advance(src, update_start, end);
                let usym = match peek(src, uus, end) {
                    Tk::Sym(k) => k,
                    _ => 10
                };
                uus = advance(src, uus, end);
                if uoff >= 0 {
                    emit("  mov " + slot(uoff) + ", %rax");
                    emit("  push %rax")
                };
                let _uep = expr(src, uus, end, v);
                emit("  pop %rcx");
                emit("  pop %rax");
                if usym >= 34 && usym <= 38 {
                    emit_compound(usym)
                } else {
                    emit("  add %rcx, %rax")
                };
                if uoff >= 0 {
                    emit("  mov %rax, " + slot(uoff))
                };
                emit("  jmp " + lbl.start);
                emit(lbl.end + ":");
                s = body.0;
                v = body.1;
                vc = if body.2 > init_r.2 { body.2 } else { init_r.2 };
                0
            },
            Tk::Kw(40) => {
                let lbl = make_label(vc);
                s = advance(src, s, end);
                emit(lbl.start + ":");
                let b = do_block(src, s, end, v, lbl.next, end_lbl, lbl.end, lbl.start);
                s = b.0;
                v = b.1;
                vc = b.2;
                s = advance(src, s, end);
                let ep = expr(src, s, end, v);
                s = ep;
                emit("  pop %rax");
                emit("  cmp $0, %rax");
                emit("  jne " + lbl.start);
                s = advance(src, s, end);
                emit(lbl.end + ":");
                0
            },
            Tk::Kw(41) => {
                s = advance(src, s, end);
                s = advance(src, s, end);
                if len(brk) > 0 {
                    emit("  jmp " + brk)
                } else {
                    0
                };
                0
            },
            Tk::Kw(42) => {
                s = advance(src, s, end);
                s = advance(src, s, end);
                if len(cont) > 0 {
                    emit("  jmp " + cont)
                } else {
                    0
                };
                0
            },
            Tk::Kw(45) => {
                s = advance(src, s, end);
                s = advance(src, s, end);
                let ep = expr(src, s, end, v);
                s = ep;
                emit("  pop %rax");
                s = advance(src, s, end);
                s = advance(src, s, end);
                let sw_start = s;
                let sw_lbl = vc * 100;
                let sw_end = ".Lsw" + to_string(sw_lbl) + "end";
                let sw_def = ".Lsw" + to_string(sw_lbl) + "def";
                let ci = 1;
                let has_def = false;
                let cases = "";
                let pass1 = while s < end {
                    let tk = peek(src, s, end);
                    if match tk { Tk::Sym(8) => true, _ => false } {
                        break; 0
                    } else if match tk { Tk::Kw(46) => true, _ => false } {
                        s = advance(src, s, end);
                        let cv = match peek(src, s, end) {
                            Tk::Num(n) => n,
                            _ => 0
                        };
                        s = advance(src, s, end);
                        s = advance(src, s, end);
                        cases = cases + to_string(cv) + ",";
                        ci = ci + 1;
                        0
                    } else if match tk { Tk::Kw(47) => true, _ => false } {
                        has_def = true;
                        s = advance(src, s, end);
                        s = advance(src, s, end);
                        ci = ci + 1;
                        0
                    } else {
                        s = advance(src, s, end);
                        0
                    }
                };
                s = sw_start;
                let p = 0;
                let ci2 = 1;
                let nc = len(cases);
                let pass1b = while p < nc {
                    let cp = find_ch(cases, p, 44);
                    let cv2 = pn(cases, p, cp);
                    let cl = ".Lsw" + to_string(sw_lbl) + "c" + to_string(ci2);
                    emit("  cmp $" + to_string(cv2) + ", %rax");
                    emit("  je " + cl);
                    p = cp + 1;
                    ci2 = ci2 + 1;
                    0
                };
                if has_def {
                    emit("  jmp " + sw_def)
                } else {
                    emit("  jmp " + sw_end)
                };
                let ci3 = 1;
                let p2 = 0;
                let pass2 = while s < end {
                    let tk = peek(src, s, end);
                    if match tk { Tk::Sym(8) => true, _ => false } {
                        s = advance(src, s, end);
                        break; 0
                    } else if match tk { Tk::Kw(46) => true, _ => false } {
                        s = advance(src, s, end);
                        s = advance(src, s, end);
                        s = advance(src, s, end);
                        let cl = ".Lsw" + to_string(sw_lbl) + "c" + to_string(ci3);
                        emit(cl + ":");
                        ci3 = ci3 + 1;
                        0
                    } else if match tk { Tk::Kw(47) => true, _ => false } {
                        s = advance(src, s, end);
                        s = advance(src, s, end);
                        emit(sw_def + ":");
                        ci3 = ci3 + 1;
                        0
                    } else if match tk { Tk::Sym(7) => true, _ => false } {
                        s = advance(src, s, end);
                        0
                    } else if match tk { Tk::Kw(7) => true, _ => false } {
                        s = advance(src, s, end);
                        let ep = expr(src, s, end, v);
                        s = ep;
                        emit("  pop %rax");
                        s = advance(src, s, end);
                        0
                    } else if match tk { Tk::Kw(41) => true, _ => false } {
                        s = advance(src, s, end);
                        s = advance(src, s, end);
                        emit("  jmp " + sw_end);
                        0
                    } else {
                        let st = do_single_stmt(src, s, end, v, vc, sw_end, sw_end, cont);
                        s = st.0;
                        v = st.1;
                        vc = st.2;
                        0
                    }
                };
                emit(sw_end + ":");
                0
            },
            _ => {
                let first = peek(src, s, end);
                if match first { Tk::Sym(17) => true, _ => false } {
                    s = advance(src, s, end);
                    let ptr_ep = p_unary(src, s, end, v);
                    s = ptr_ep;
                    let eq_tk = peek(src, s, end);
                    if match eq_tk { Tk::Sym(10) => true, _ => false } {
                        s = advance(src, s, end);
                        let val_ep = expr(src, s, end, v);
                        s = val_ep;
                        emit("  pop %rax");
                        emit("  pop %rcx");
                        emit("  mov %rax, (%rcx)");
                        s = advance(src, s, end);
                        0
                    } else {
                        emit("  pop %rax");
                        s = advance(src, s, end);
                        0
                    }
                } else {
                let name = token_val(src, s, end);
                s = advance(src, s, end);
                let sym = match peek(src, s, end) {
                    Tk::Sym(k) => k,
                    _ => 10
                };
                if sym == 32 {
                    s = advance(src, s, end);
                    let idx_ep = expr(src, s, end, v);
                    s = idx_ep;
                    s = advance(src, s, end);
                    let eq_sym = match peek(src, s, end) {
                        Tk::Sym(k) => k,
                        _ => 10
                    };
                    if eq_sym == 10 {
                        s = advance(src, s, end)
                    };
                    let off = var_off(v, name);
                    let val_ep = expr(src, s, end, v);
                    s = val_ep;
                    emit("  pop %rax");
                    emit("  pop %rcx");
                    emit("  neg %rcx");
                    emit("  mov %rax, " + to_string(0 - (off + 1) * 8) + "(%rbp, %rcx, 8)");
                    s = advance(src, s, end);
                    0
                } else {
                    s = advance(src, s, end);
                    let off = var_off(v, name);
                    if sym == 6 {
                        let ac = 0;
                        let rp = while s < end {
                            let pt = peek(src, s, end);
                            if match pt { Tk::Sym(7) => true, _ => false } {
                                s = advance(src, s, end);
                                break; 0
                            } else if match pt { Tk::Sym(5) => true, _ => false } {
                                s = advance(src, s, end);
                                0
                            } else {
                                let ep = expr(src, s, end, v);
                                emit("  push %rax");
                                s = ep;
                                ac = ac + 1;
                                0
                            }
                        };
                        emit("  call " + name);
                        if ac > 0 {
                            emit("  add $" + to_string(ac * 8) + ", %rsp")
                        };
                        emit("  push %rax");
                        emit("  pop %rax");
                        s = advance(src, s, end);
                        0
                    } else if sym == 10 {
                        let ep = expr(src, s, end, v);
                        s = ep;
                        emit("  pop %rax");
                        store_var(name, off);
                        s = advance(src, s, end);
                        0
                    } else if sym >= 34 && sym <= 38 {
                        load_var(name, off);
                        emit("  push %rax");
                        let ep = expr(src, s, end, v);
                        s = ep;
                        emit("  pop %rcx");
                        emit("  pop %rax");
                        emit_compound(sym);
                        store_var(name, off);
                        s = advance(src, s, end);
                        0
                    } else {
                        let ep = expr(src, s, end, v);
                        s = ep;
                        emit("  pop %rax");
                        store_var(name, off);
                        s = advance(src, s, end);
                        0
                    }
                }
            }
            }
        }
    };
    if returned == 1 {
        s = skip_to_close(src, s, end)
    };
    (s, v, vc)
}

fn do_for_init(src: string, pos: number, end: number, vars: string, vc: number) -> (number, string, number) {
    let s = pos;
    let v = vars;
    let nvc = vc;
    match peek(src, s, end) {
        Tk::Sym(5) => {
            s = advance(src, s, end);
            (s, v, nvc)
        },
        Tk::Kw(1) | Tk::Kw(44) => {
            s = advance(src, s, end);
            let name = token_val(src, s, end);
            s = advance(src, s, end);
            let off = nvc;
            nvc = nvc + 1;
            emit("  mov $0, " + slot(off));
            v = v + name + ":" + to_string(off) + ",";
            match peek(src, s, end) {
                Tk::Sym(10) => {
                    s = advance(src, s, end);
                    let ep = expr(src, s, end, v);
                    s = ep;
                    emit("  pop %rax");
                    emit("  mov %rax, " + slot(off));
                    s = advance(src, s, end);
                    (s, v, nvc)
                },
                _ => {
                    s = advance(src, s, end);
                    (s, v, nvc)
                }
            }
        },
        _ => {
            let name = token_val(src, s, end);
            let off = var_off(v, name);
            s = advance(src, s, end);
            let sym = match peek(src, s, end) {
                Tk::Sym(k) => k,
                _ => 10
            };
            s = advance(src, s, end);
            let ep = expr(src, s, end, v);
            s = ep;
            emit("  pop %rax");
            if off >= 0 {
                emit("  mov %rax, " + slot(off))
            };
            s = advance(src, s, end);
            (s, v, nvc)
        }
    }
}

fn do_single_stmt(src: string, pos: number, end: number, vars: string, vc: number, end_lbl: string, brk: string, cont: string) -> (number, string, number) {
    let s = pos;
    let v = vars;
    let nvc = vc;
    match peek(src, s, end) {
        Tk::Sym(4) => {
            let b = do_block_braced(src, s, end, v, nvc, end_lbl, brk, cont);
            (b.0, b.1, b.2)
        },
        Tk::Kw(20) => {
            s = advance(src, s, end);
            let ep = expr(src, s, end, v);
            emit("  pop %rax");
            emit("  jmp " + end_lbl);
            (advance(src, ep, end), v, nvc)
        },
        Tk::Kw(19) => {
            let lbl = make_label(nvc);
            s = advance(src, s, end);
            let ep = expr(src, s, end, v);
            s = ep;
            emit("  pop %rax");
            emit("  cmp $0, %rax");
            emit("  je " + lbl.start);
            let b = do_block(src, s, end, v, lbl.next, end_lbl, brk, cont);
            emit("  jmp " + lbl.end);
            emit(lbl.start + ":");
            s = b.0;
            v = b.1;
            nvc = b.2;
            let has_else = s < end && is_kw(peek(src, s, end), 22);
            if has_else {
                s = advance(src, s, end);
                let b2 = do_block(src, s, end, v, nvc + 1, end_lbl, brk, cont);
                emit(lbl.end + ":");
                (b2.0, b2.1, b2.2)
            } else {
                emit(lbl.end + ":");
                (s, v, nvc)
            }
        },
        Tk::Kw(21) => {
            let lbl = make_label(nvc);
            s = advance(src, s, end);
            emit(lbl.start + ":");
            let ep = expr(src, s, end, v);
            s = ep;
            emit("  pop %rax");
            emit("  cmp $0, %rax");
            emit("  je " + lbl.end);
            let b = do_block(src, s, end, v, lbl.next, end_lbl, lbl.end, lbl.start);
            emit("  jmp " + lbl.start);
            emit(lbl.end + ":");
            (b.0, b.1, b.2)
        },
        Tk::Kw(40) => {
            let lbl = make_label(nvc);
            s = advance(src, s, end);
            emit(lbl.start + ":");
            let b = do_block(src, s, end, v, lbl.next, end_lbl, lbl.end, lbl.start);
            s = b.0;
            let nvc2 = b.2;
            s = advance(src, s, end);
            let ep = expr(src, s, end, b.1);
            s = ep;
            emit("  pop %rax");
            emit("  cmp $0, %rax");
            emit("  jne " + lbl.start);
            s = advance(src, s, end);
            emit(lbl.end + ":");
            (s, b.1, nvc2)
        },
        Tk::Kw(41) => {
            s = advance(src, s, end);
            s = advance(src, s, end);
            if len(brk) > 0 { emit("  jmp " + brk) } else { 0 };
            (s, v, nvc)
        },
        Tk::Kw(42) => {
            s = advance(src, s, end);
            s = advance(src, s, end);
            if len(cont) > 0 { emit("  jmp " + cont) } else { 0 };
            (s, v, nvc)
        },
        _ => {
            let name = token_val(src, s, end);
            s = advance(src, s, end);
            let sym = match peek(src, s, end) {
                Tk::Sym(k) => k,
                _ => 10
            };
            if sym == 10 {
                s = advance(src, s, end);
                let ep = expr(src, s, end, v);
                s = ep;
                emit("  pop %rax");
                let off = var_off(v, name);
                store_var(name, off);
                s = advance(src, s, end);
                (s, v, nvc)
            } else {
                s = expr(src, s, end, v);
                emit("  pop %rax");
                (advance(src, s, end), v, nvc)
            }
        }
    }
}

fn skip_to_close(src: string, pos: number, end: number) -> number {
    let s = pos;
    let depth = 0;
    let r = while s < end {
        let tk = peek(src, s, end);
        let is_close = match tk { Tk::Sym(8) => true, _ => false };
        let is_open = match tk { Tk::Sym(4) => true, _ => false };
        if is_close && depth == 0 {
            s = advance(src, s, end);
            break; 0
        } else {
            if is_close { depth = depth - 1; 0 } else { 0 };
            if is_open { depth = depth + 1; 0 } else { 0 };
            s = advance(src, s, end);
            0
        }
    };
    s
}

fn do_stmt(src: string, pos: number, end: number, vars: string) -> number {
    let name = token_val(src, pos, end);
    let s = advance(src, pos, end);
    let sym = match peek(src, s, end) {
        Tk::Sym(k) => k,
        _ => 10
    };
    s = advance(src, s, end);
    let off = var_off(vars, name);
    let ep = expr(src, s, end, vars);
    s = ep;
    emit("  pop %rax");
    emit("  mov %rax, " + slot(off));
    s = advance(src, s, end);
    0
}

fn do_stmt_update(src: string, start: number, varend: string, end: number, vars: string) -> number {
    let s = start;
    let r = while s < end {
        match peek(src, s, end) {
            Tk::Sym(7) => { s = advance(src, s, end); break },
            _ => { s = advance(src, s, end) }
        }
    };
    s
}

fn expr(src: string, pos: number, end: number, vars: string) -> number {
    let s = p_or(src, pos, end, vars);
    let is_q = match peek(src, s, end) { Tk::Sym(48) => true, _ => false };
    if is_q {
        s = advance(src, s, end);
        let s_true = p_or(src, s, end, vars);
        s = advance(src, s_true, end);
        let s_false = p_or(src, s, end, vars);
        s = s_false;
        emit("  pop %rcx");
        emit("  pop %rax");
        emit("  pop %rdx");
        emit("  cmp $0, %rdx");
        emit("  cmovz %rcx, %rax");
        emit("  push %rax");
        s
    } else {
        s
    }
}

fn p_or(src: string, pos: number, end: number, vars: string) -> number {
    let s = p_and(src, pos, end, vars);
    let r = while match peek(src, s, end) { Tk::Sym(25) => true, _ => false } {
        s = advance(src, s, end);
        let s2 = p_and(src, s, end, vars);
        emit("  pop %rcx");
        emit("  pop %rax");
        emit("  or %rcx, %rax");
        emit("  push %rax");
        s = s2
    };
    s
}

fn p_and(src: string, pos: number, end: number, vars: string) -> number {
    let s = p_eq(src, pos, end, vars);
    let r = while match peek(src, s, end) { Tk::Sym(26) => true, _ => false } {
        s = advance(src, s, end);
        let s2 = p_eq(src, s, end, vars);
        emit("  pop %rcx");
        emit("  pop %rax");
        emit("  and %rcx, %rax");
        emit("  push %rax");
        s = s2
    };
    s
}

fn p_eq(src: string, pos: number, end: number, vars: string) -> number {
    let s = p_bitwise(src, pos, end, vars);
    let r = while match peek(src, s, end) {
        Tk::Sym(23) => true,
        Tk::Sym(27) => true,
        _ => false
    } {
        let op = match peek(src, s, end) { Tk::Sym(23) => "sete", _ => "setne" };
        s = advance(src, s, end);
        let s2 = p_bitwise(src, s, end, vars);
        emit("  pop %rcx");
        emit("  pop %rax");
        emit("  cmp %rcx, %rax");
        emit("  " + op + " %al");
        emit("  movzx %al, %rax");
        emit("  push %rax");
        s = s2
    };
    s
}

fn p_bitwise(src: string, pos: number, end: number, vars: string) -> number {
    let s = p_cmp(src, pos, end, vars);
    let r = while match peek(src, s, end) {
        Tk::Sym(50) => true,
        Tk::Sym(51) => true,
        Tk::Sym(52) => true,
        _ => false
    } {
        let op = match peek(src, s, end) {
            Tk::Sym(50) => "and",
            Tk::Sym(51) => "or",
            _ => "xor"
        };
        s = advance(src, s, end);
        let s2 = p_cmp(src, s, end, vars);
        emit("  pop %rcx");
        emit("  pop %rax");
        emit("  " + op + " %rcx, %rax");
        emit("  push %rax");
        s = s2
    };
    s
}

fn p_cmp(src: string, pos: number, end: number, vars: string) -> number {
    let s = p_shift(src, pos, end, vars);
    let r = while match peek(src, s, end) {
        Tk::Sym(11) => true,
        Tk::Sym(13) => true,
        Tk::Sym(28) => true,
        Tk::Sym(29) => true,
        _ => false
    } {
        let op = match peek(src, s, end) {
            Tk::Sym(11) => "setl",
            Tk::Sym(13) => "setg",
            Tk::Sym(28) => "setle",
            _ => "setge"
        };
        s = advance(src, s, end);
        let s2 = p_shift(src, s, end, vars);
        emit("  pop %rcx");
        emit("  pop %rax");
        emit("  cmp %rcx, %rax");
        emit("  " + op + " %al");
        emit("  movzx %al, %rax");
        emit("  push %rax");
        s = s2
    };
    s
}

fn p_shift(src: string, pos: number, end: number, vars: string) -> number {
    let s = p_add(src, pos, end, vars);
    let r = while match peek(src, s, end) {
        Tk::Sym(54) => true,
        Tk::Sym(55) => true,
        _ => false
    } {
        let op = match peek(src, s, end) { Tk::Sym(54) => "shl", _ => "sar" };
        s = advance(src, s, end);
        let s2 = p_add(src, s, end, vars);
        emit("  pop %rcx");
        emit("  pop %rax");
        emit("  " + op + " %cl, %rax");
        emit("  push %rax");
        s = s2
    };
    s
}

fn p_add(src: string, pos: number, end: number, vars: string) -> number {
    let s = p_mul(src, pos, end, vars);
    let r = while match peek(src, s, end) {
        Tk::Sym(15) => true,
        Tk::Sym(16) => true,
        _ => false
    } {
        let op = match peek(src, s, end) { Tk::Sym(15) => "add", _ => "sub" };
        s = advance(src, s, end);
        let s2 = p_mul(src, s, end, vars);
        emit("  pop %rcx");
        emit("  pop %rax");
        emit("  " + op + " %rcx, %rax");
        emit("  push %rax");
        s = s2
    };
    s
}

fn p_mul(src: string, pos: number, end: number, vars: string) -> number {
    let s = p_unary(src, pos, end, vars);
    let r = while match peek(src, s, end) {
        Tk::Sym(17) => true,
        Tk::Sym(18) => true,
        Tk::Sym(30) => true,
        _ => false
    } {
        let k = match peek(src, s, end) {
            Tk::Sym(17) => 17,
            Tk::Sym(18) => 18,
            _ => 30
        };
        s = advance(src, s, end);
        let s2 = p_unary(src, s, end, vars);
        emit("  pop %rcx");
        emit("  pop %rax");
        if k == 17 {
            emit("  imul %rcx, %rax");
            emit("  push %rax")
        } else {
            emit("  cqto");
            emit("  idiv %rcx");
            if k == 18 { emit("  push %rax") } else { emit("  push %rdx") }
        };
        s = s2
    };
    s
}

fn p_unary(src: string, pos: number, end: number, vars: string) -> number {
    match peek(src, pos, end) {
        Tk::Sym(16) => {
            let s = advance(src, pos, end);
            let s2 = p_unary(src, s, end, vars);
            emit("  pop %rax");
            emit("  neg %rax");
            emit("  push %rax");
            s2
        },
        Tk::Sym(31) => {
            let s = advance(src, pos, end);
            let s2 = p_unary(src, s, end, vars);
            emit("  pop %rax");
            emit("  cmp $0, %rax");
            emit("  sete %al");
            emit("  movzx %al, %rax");
            emit("  push %rax");
            s2
        },
        Tk::Sym(53) => {
            let s = advance(src, pos, end);
            let s2 = p_unary(src, s, end, vars);
            emit("  pop %rax");
            emit("  not %rax");
            emit("  push %rax");
            s2
        },
        Tk::Sym(50) => {
            let s = advance(src, pos, end);
            let name = token_val(src, s, end);
            let off = var_off(vars, name);
            if off >= 0 {
                emit("  lea " + to_string(0 - (off + 1) * 8) + "(%rbp), %rax")
            } else {
                emit("  lea " + name + "(%rip), %rax")
            };
            emit("  push %rax");
            advance(src, s, end)
        },
        Tk::Sym(17) => {
            let s = advance(src, pos, end);
            let s2 = p_unary(src, s, end, vars);
            emit("  pop %rax");
            emit("  mov (%rax), %rax");
            emit("  push %rax");
            s2
        },
        Tk::Kw(50) => {
            let s = advance(src, pos, end);
            s = advance(src, s, end);
            let tk = peek(src, s, end);
            if match tk { Tk::Kw(1) => true, Tk::Kw(44) => true, _ => false } {
                s = advance(src, s, end)
            };
            emit("  push $8");
            advance(src, s, end)
        },
        _ => p_primary(src, pos, end, vars)
    }
}

fn p_primary(src: string, pos: number, end: number, vars: string) -> number {
    match peek(src, pos, end) {
        Tk::Num(v) => {
            emit("  push $" + to_string(v));
            advance(src, pos, end)
        },
        Tk::Id(name) => {
            let next = peek(src, advance(src, pos, end), end);
            if match next { Tk::Sym(6) => true, _ => false } {
                emit_call(src, pos, end, vars)
            } else if match next { Tk::Sym(32) => true, _ => false } {
                let s = advance(src, pos, end);
                s = advance(src, s, end);
                let ep = expr(src, s, end, vars);
                let off = var_off(vars, name);
                emit("  pop %rax");
                emit("  neg %rax");
                emit("  mov " + to_string(0 - (off + 1) * 8) + "(%rbp, %rax, 8), %rcx");
                emit("  push %rcx");
                advance(src, ep, end)
            } else {
                let off = var_off(vars, name);
                if off >= 0 {
                    emit("  mov " + slot(off) + ", %rax");
                    emit("  push %rax");
                    advance(src, pos, end)
                } else {
                    emit("  movq " + name + "(%rip), %rax");
                    emit("  push %rax");
                    advance(src, pos, end)
                }
            }
        },
        Tk::Sym(6) => {
            let s = advance(src, pos, end);
            let ep = expr(src, s, end, vars);
            advance(src, ep, end)
        },
        _ => {
            emit("  push $0");
            advance(src, pos, end)
        }
    }
}

fn emit_call(src: string, pos: number, end: number, vars: string) -> number {
    let name = token_val(src, pos, end);
    let s = advance(src, pos, end);
    s = advance(src, s, end);
    let ac = 0;
    let r = while match peek(src, s, end) { Tk::Sym(7) => false, _ => true } {
        match peek(src, s, end) {
            Tk::Sym(9) => { s = advance(src, s, end) },
            _ => { s = expr(src, s, end, vars); ac = ac + 1 }
        }
    };
    let save_pop = |n: number| {
        if ac >= n { emit("  pop " + param_reg(n - 1)); 0 } else { 0 }
    };
    save_pop(4);
    save_pop(3);
    save_pop(2);
    save_pop(1);
    emit("  call " + name);
    emit("  push %rax");
    advance(src, s, end)
}

fn emit_compound(sym: number) -> number {
    if sym == 37 || sym == 38 {
        emit("  cqto");
        emit("  idiv %rcx");
        if sym == 38 { emit("  mov %rdx, %rax") } else { 0 }
    } else {
        let op = if sym == 34 { "add" } else if sym == 35 { "sub" } else if sym == 36 { "imul" } else { "idiv" };
        emit("  " + op + " %rcx, %rax")
    }
}

fn peek(src: string, pos: number, end: number) -> Tk {
    let i = skip_ws(src, pos, end);
    if i >= end {
        Tk::Eof
    } else {
        let c = str_index(src, i);
        if is_char_literal(c) == 1 {
            let v = parse_char(src, i, end);
            Tk::Num(v.0)
        } else if is_d(c) == 1 {
            let v = parse_num(src, i, end);
            Tk::Num(v.0)
        } else if is_a(c) == 1 {
            let id = parse_ident(src, i, end);
            let kw = keyword_id(id.0);
            if kw > 0 { Tk::Kw(kw) } else { Tk::Id(id.0) }
        } else {
            let s = lex_sym(src, i, end);
            Tk::Sym(s.0)
        }
    }
}

fn advance(src: string, pos: number, end: number) -> number {
    let i = skip_ws(src, pos, end);
    if i >= end {
        end
    } else {
        let c = str_index(src, i);
        if is_char_literal(c) == 1 { parse_char(src, i, end).1 }
        else if is_d(c) == 1 { parse_num(src, i, end).1 }
        else if is_a(c) == 1 { parse_ident(src, i, end).1 }
        else { lex_sym(src, i, end).1 }
    }
}

fn token_val(src: string, pos: number, end: number) -> string {
    let i = skip_ws(src, pos, end);
    let c = str_index(src, i);
    if is_char_literal(c) == 1 { to_string(parse_char(src, i, end).0) }
    else if is_d(c) == 1 { to_string(parse_num(src, i, end).0) }
    else if is_a(c) == 1 { parse_ident(src, i, end).0 }
    else { "" }
}

fn skip_ws(src: string, pos: number, end: number) -> number {
    let i = pos;
    let r = while i < end {
        let c = str_index(src, i);
        if c == 47 && i + 1 < end && str_index(src, i + 1) == 47 {
            let r2 = while i < end && str_index(src, i) != 10 { i = i + 1 }; 0
        } else if c == 47 && i + 1 < end && str_index(src, i + 1) == 42 {
            i = i + 2;
            let r2 = while i + 1 < end && (str_index(src, i) != 42 || str_index(src, i + 1) != 47) { i = i + 1 };
            i = i + 2; 0
        } else if c == 32 || c == 10 || c == 13 || c == 9 {
            i = i + 1; 0
        } else {
            break; 0
        }
    };
    i
}

fn parse_num(src: string, start: number, end: number) -> (number, number) {
    let v = 0;
    let i = start;
    let r = while i < end && is_d(str_index(src, i)) == 1 {
        v = v * 10 + (str_index(src, i) - 48);
        i = i + 1
    };
    (v, i)
}

fn parse_char(src: string, start: number, end: number) -> (number, number) {
    let i = start + 1;
    let v = if i < end { str_index(src, i) } else { 0 };
    if v == 92 {
        i = i + 1;
        let esc = if i < end { str_index(src, i) } else { 0 };
        if esc == 110 { v = 10 }
        else if esc == 116 { v = 9 }
        else if esc == 114 { v = 13 }
        else if esc == 92 { v = 92 }
        else if esc == 39 { v = 39 }
        else { v = esc }
    };
    if i + 1 < end { i = i + 1 };
    (v, i + 1)
}

fn is_char_literal(c: number) -> number {
    if c == 39 { 1 } else { 0 }
}

fn parse_ident(src: string, start: number, end: number) -> (string, number) {
    let w = "";
    let i = start;
    let r = while i < end && is_an(str_index(src, i)) == 1 {
        w = w + char_to_string(str_index(src, i));
        i = i + 1
    };
    (w, i)
}

fn lex_sym(src: string, i: number, end: number) -> (number, number) {
    let c = str_index(src, i);
    let c2 = if i + 1 < end { str_index(src, i + 1) } else { 0 };
    let two = two_char(c, c2);
    if two.0 > 0 { (two.0, i + 2) } else { (single_char(c), i + 1) }
}

fn two_char(c: number, c2: number) -> (number, number) {
    if c == 61 && c2 == 61 { (23, 2) }
    else if c == 33 && c2 == 61 { (27, 2) }
    else if c == 60 && c2 == 61 { (28, 2) }
    else if c == 62 && c2 == 61 { (29, 2) }
    else if c == 38 && c2 == 38 { (26, 2) }
    else if c == 124 && c2 == 124 { (25, 2) }
    else if c == 60 && c2 == 60 { (54, 2) }
    else if c == 62 && c2 == 62 { (55, 2) }
    else if c == 43 && c2 == 61 { (34, 2) }
    else if c == 45 && c2 == 61 { (35, 2) }
    else if c == 42 && c2 == 61 { (36, 2) }
    else if c == 47 && c2 == 61 { (37, 2) }
    else if c == 37 && c2 == 61 { (38, 2) }
    else { (0, 0) }
}

fn single_char(c: number) -> number {
    if c == 40 { 6 }
    else if c == 41 { 7 }
    else if c == 123 { 4 }
    else if c == 125 { 8 }
    else if c == 59 { 5 }
    else if c == 44 { 9 }
    else if c == 91 { 32 }
    else if c == 93 { 33 }
    else if c == 61 { 10 }
    else if c == 60 { 11 }
    else if c == 62 { 13 }
    else if c == 33 { 31 }
    else if c == 43 { 15 }
    else if c == 45 { 16 }
    else if c == 42 { 17 }
    else if c == 47 { 18 }
    else if c == 37 { 30 }
    else if c == 63 { 48 }
    else if c == 58 { 49 }
    else if c == 38 { 50 }
    else if c == 124 { 51 }
    else if c == 94 { 52 }
    else if c == 126 { 53 }
    else { 0 }
}

fn keyword_id(w: string) -> number {
    if eq(w, "int") { 1 }
    else if eq(w, "return") { 20 }
    else if eq(w, "while") { 21 }
    else if eq(w, "if") { 19 }
    else if eq(w, "else") { 22 }
    else if eq(w, "for") { 24 }
    else if eq(w, "do") { 40 }
    else if eq(w, "break") { 41 }
    else if eq(w, "continue") { 42 }
    else if eq(w, "void") { 43 }
    else if eq(w, "char") { 44 }
    else if eq(w, "switch") { 45 }
    else if eq(w, "case") { 46 }
    else if eq(w, "default") { 47 }
    else if eq(w, "sizeof") { 50 }
    else { 0 }
}

fn is_d(c: number) -> number {
    if c >= 48 && c <= 57 { 1 } else { 0 }
}

fn is_a(c: number) -> number {
    if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 { 1 } else { 0 }
}

fn is_an(c: number) -> number {
    if is_a(c) == 1 { 1 } else { is_d(c) }
}

fn eq(a: string, b: string) -> bool {
    if len(a) != len(b) { false } else {
        let i = 0;
        let ok = true;
        let r = while i < len(a) && ok {
            if str_index(a, i) != str_index(b, i) { ok = false; 0 } else { 0 };
            i = i + 1
        };
        ok
    }
}

fn var_off(vm: string, name: string) -> number {
    let p = find_ch(vm, 0, 58);
    let i = 0;
    let found = false;
    let last_p = 0;
    let r = while p < len(vm) {
        let nm = sub_str(vm, i, p);
        if eq(nm, name) { found = true; last_p = p; 0 } else { 0 };
        let ns = p + 1;
        let cp = find_ch(vm, ns, 44);
        i = cp + 1;
        p = find_ch(vm, i, 58)
    };
    if !found { return -1 };
    let ns2 = last_p + 1;
    let sc = find_ch(vm, ns2, 59);
    let cm = find_ch(vm, ns2, 44);
    if sc < cm { pn(vm, ns2, sc) } else { pn(vm, ns2, cm) }
}

fn skip_matching(src: string, pos: number, end: number) -> number {
    let depth = 0;
    let i = pos;
    let r = while i < end {
        match peek(src, i, end) {
            Tk::Sym(4) => { depth = depth + 1; 0 },
            Tk::Sym(8) => { depth = depth - 1; 0 },
            _ => 0
        };
        i = advance(src, i, end);
        if depth == 0 { break; 0 } else { 0 }
    };
    i
}

fn find_nth(s: string, ch: number, n: number) -> number {
    let i = 0;
    let count = 0;
    let r = while i < len(s) && count < n {
        if str_index(s, i) == ch { count = count + 1; 0 } else { 0 };
        i = i + 1
    };
    i
}

fn find_ch(s: string, start: number, ch: number) -> number {
    let i = start;
    let r = while i < len(s) {
        if str_index(s, i) == ch { break; 0 } else { 0 };
        i = i + 1
    };
    i
}

fn sub_str(s: string, a: number, b: number) -> string {
    let out = "";
    let i = a;
    let r = while i < b {
        out = out + char_to_string(str_index(s, i));
        i = i + 1
    };
    out
}

fn pn(s: string, a: number, b: number) -> number {
    if a >= b { 0 } else {
        let v = 0;
        let i = a;
        let r = while i < b {
            v = v * 10 + (str_index(s, i) - 48);
            i = i + 1
        };
         v
   }
}

fn is_kw(tk: Tk, k: number) -> bool {
   match tk {
      Tk::Kw(n) => if n == k { true } else { false },
      _ => false
   }
}
