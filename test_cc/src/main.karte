module main

enum Tk {
    Num(number),
    Id(string),
    Kw(number),
    Sym(number),
    Eof
}

struct Label { start: string, end: string, next: number }

fn emit(s: string) -> number { print(s + "\n"); 0 }

fn main() -> number {
    let buf = gc_alloc(65536 + 8);
    let n = sys_read(0, buf + 8, 65535);
    if n <= 0 {
        print("error: no input\n");
        1
    } else {
        mem_store64(buf, n);
        compile(unsafe_cast(buf), 0, n)
    }
}

fn compile(src: string, pos: number, end: number) -> number {
    emit(".globl _start");
    emit("_start:");
    emit("  call main");
    emit("  mov %rax, %rdi");
    emit("  mov $60, %rax");
    emit("  syscall");
    let state = pos;
    let lc = 0;
    let r = while state < end {
        match peek(src, state, end) {
            Tk::Kw(1) => {
                let func = parse_func(src, state, end, lc);
                emit_func(func.0, func.1);
                let body = do_block(src, func.2, end, func.3, lc + func.1 * 10);
                emit("  leave");
                emit("  ret");
                state = skip_matching(src, func.2, end) + 1;
                lc = body.2
            },
            _ => { state = advance(src, state, end) }
        }
    };
    0
}

fn emit_func(name: string, argc: number) -> number {
    emit(name + ":");
    emit("  push %rbp");
    emit("  mov %rsp, %rbp");
    emit("  sub $208, %rsp");
    let i = 0;
    let r = while i < argc {
        emit("  mov " + param_reg(i) + ", " + slot(i));
        i = i + 1
    };
    0
}

fn parse_func(src: string, pos: number, end: number, lc: number) -> (string, number, number, string) {
    let s = advance(src, pos, end);
    let name = token_val(src, s, end);
    s = advance(src, s, end);
    let cp = parse_params(src, s, end);
    let argc = cp.0;
    s = cp.1;
    let vars = cp.2;
    let body_start = advance(src, s, end);
    (name, argc, body_start, vars)
}

fn parse_params(src: string, pos: number, end: number) -> (number, number, string) {
    if match peek(src, pos, end) { Tk::Sym(7) => true, _ => false } {
        (0, advance(src, pos, end), "")
    } else {
        let vars = "";
        let c = 0;
        let s = advance(src, pos, end);
        let done2 = 0;
        let r = while done2 == 0 {
            match peek(src, s, end) {
                Tk::Sym(7) => {
                    done2 = 1;
                    s = advance(src, s, end);
                    0
                },
                Tk::Kw(1) => {
                    s = advance(src, s, end);
                    let pname = token_val(src, s, end);
                    s = advance(src, s, end);
                    vars = vars + pname + ":" + to_string(c) + ",";
                    c = c + 1;
                    if match peek(src, s, end) { Tk::Sym(9) => true, _ => false } {
                        s = advance(src, s, end); 0
                    } else { 0 };
                    0
                },
                _ => { s = advance(src, s, end); 0 }
            }
        };
        (c, s, vars)
    }
}

fn param_reg(idx: number) -> string {
    match idx {
        0 => "%rdi",
        1 => "%rsi",
        2 => "%rdx",
        3 => "%rcx",
        4 => "%r8",
        _ => "%r9"
    }
}

fn slot(off: number) -> string {
    to_string(0 - (off + 1) * 8) + "(%rbp)"
}

fn make_label(lc: number) -> Label {
    Label { start: ".L" + to_string(lc), end: ".L" + to_string(lc + 1), next: lc + 2 }
}

fn do_block(src: string, pos: number, end: number, vars: string, lc: number) -> (number, string, number) {
    let s = pos;
    let v = vars;
    let vc = lc;
    let done = 0;
    let r = while done == 0 && s < end {
        match peek(src, s, end) {
            Tk::Sym(4) => {
                s = advance(src, s, end);
                0
            },
            Tk::Sym(8) => {
                done = 1;
                s = advance(src, s, end);
                0
            },
            Tk::Sym(5) => {
                s = advance(src, s, end);
                0
            },
            Tk::Kw(1) => {
                let dummy = advance(src, s, end);
                let name = token_val(src, s, end);
                s = advance(src, s, end);
                match peek(src, s, end) {
                    Tk::Sym(32) => {
                        s = advance(src, s, end);
                        let cnt = match peek(src, s, end) {
                            Tk::Num(n) => n,
                            _ => 0
                        };
                        s = advance(src, s, end);
                        s = advance(src, s, end);
                        v = v + name + ":" + to_string(vc) + ";" + to_string(cnt) + ",";
                        vc = vc + cnt;
                        0
                    },
                    _ => {
                        s = advance(src, s, end);
                        v = v + name + ":" + to_string(vc) + ",";
                        vc = vc + 1;
                        0
                    }
                }
            },
            Tk::Kw(20) => {
                s = advance(src, s, end);
                let ep = expr(src, s, end, v);
                emit("  pop %rax");
                s = ep;
                s = advance(src, s, end);
                done = 1;
                0
            },
            Tk::Kw(21) => {
                let lbl = make_label(vc);
                s = advance(src, s, end);
                emit(lbl.start + ":");
                let ep = expr(src, s, end, v);
                s = ep;
                emit("  pop %rax");
                emit("  cmp $0, %rax");
                emit("  je " + lbl.end);
                let b = do_block(src, s, end, v, lbl.next);
                emit("  jmp " + lbl.start);
                emit(lbl.end + ":");
                s = b.0;
                v = b.1;
                vc = b.2;
                0
            },
            Tk::Kw(19) => {
                let lbl = make_label(vc);
                s = advance(src, s, end);
                let ep = expr(src, s, end, v);
                s = ep;
                emit("  pop %rax");
                emit("  cmp $0, %rax");
                emit("  je " + lbl.start);
                let b = do_block(src, s, end, v, lbl.next);
                if done == 0 {
                    emit("  jmp " + lbl.end)
                } else {
                    0
                };
                emit(lbl.start + ":");
                s = b.0;
                v = b.1;
                vc = b.2;
                let has_else = s < end && is_kw(peek(src, s, end), 22);
                if has_else {
                    s = advance(src, s, end);
                    let b2 = do_block(src, s, end, v, vc + 1);
                    emit(lbl.end + ":");
                    s = b2.0;
                    v = b2.1;
                    vc = b2.2;
                    0
                } else {
                    emit(lbl.end + ":")
                }
            },
            Tk::Kw(24) => {
                let lbl = make_label(vc);
                s = advance(src, s, end);
                s = do_stmt(src, s, end, v);
                emit(lbl.start + ":");
                let ep = expr(src, s, end, v);
                s = ep;
                emit("  pop %rax");
                emit("  cmp $0, %rax");
                emit("  je " + lbl.end);
                let upos = s;
                s = advance(src, s, end);
                let body = do_block(src, s, end, v, lbl.next);
                do_stmt_update(src, upos, body.1, end, v);
                emit("  jmp " + lbl.start);
                emit(lbl.end + ":");
                s = body.0;
                v = body.1;
                vc = body.2;
                0
            },
            _ => {
                let name = token_val(src, s, end);
                s = advance(src, s, end);
                let sym = match peek(src, s, end) {
                    Tk::Sym(k) => k,
                    _ => 10
                };
                s = advance(src, s, end);
                let off = var_off(v, name);
                if sym == 10 {
                    let ep = expr(src, s, end, v);
                    s = ep;
                    emit("  pop %rax");
                    emit("  mov %rax, " + slot(off));
                    s = advance(src, s, end);
                    0
                } else if sym >= 34 && sym <= 38 {
                    emit("  mov " + slot(off) + ", %rax");
                    emit("  push %rax");
                    let ep = expr(src, s, end, v);
                    s = ep;
                    emit("  pop %rcx");
                    emit("  pop %rax");
                    emit_compound(sym);
                    emit("  mov %rax, " + slot(off));
                    s = advance(src, s, end);
                    0
                } else {
                    let ep = expr(src, s, end, v);
                    s = ep;
                    emit("  pop %rax");
                    emit("  mov %rax, " + slot(off));
                    s = advance(src, s, end);
                    0
                }
            }
        }
    };
    if done == 1 {
        s = skip_to_close(src, s, end)
    };
    (s, v, vc)
}

fn skip_to_close(src: string, pos: number, end: number) -> number {
    let s = pos;
    let depth = 0;
    let r = while s < end {
        let tk = peek(src, s, end);
        let is_close = match tk { Tk::Sym(8) => true, _ => false };
        let is_open = match tk { Tk::Sym(4) => true, _ => false };
        if is_close && depth == 0 {
            s = advance(src, s, end);
            break; 0
        } else {
            if is_close { depth = depth - 1; 0 } else { 0 };
            if is_open { depth = depth + 1; 0 } else { 0 };
            s = advance(src, s, end);
            0
        }
    };
    s
}

fn do_stmt(src: string, pos: number, end: number, vars: string) -> number {
    let name = token_val(src, pos, end);
    let s = advance(src, pos, end);
    let sym = match peek(src, s, end) {
        Tk::Sym(k) => k,
        _ => 10
    };
    s = advance(src, s, end);
    let off = var_off(vars, name);
    let ep = expr(src, s, end, vars);
    s = ep;
    emit("  pop %rax");
    emit("  mov %rax, " + slot(off));
    s = advance(src, s, end);
    0
}

fn do_stmt_update(src: string, start: number, varend: string, end: number, vars: string) -> number {
    let s = start;
    let r = while s < end {
        match peek(src, s, end) {
            Tk::Sym(7) => { s = advance(src, s, end); break },
            _ => { s = advance(src, s, end) }
        }
    };
    s
}

fn expr(src: string, pos: number, end: number, vars: string) -> number {
    p_or(src, pos, end, vars)
}

fn p_or(src: string, pos: number, end: number, vars: string) -> number {
    let s = p_and(src, pos, end, vars);
    let r = while match peek(src, s, end) { Tk::Sym(25) => true, _ => false } {
        s = advance(src, s, end);
        let s2 = p_and(src, s, end, vars);
        emit("  pop %rcx");
        emit("  pop %rax");
        emit("  or %rcx, %rax");
        emit("  push %rax");
        s = s2
    };
    s
}

fn p_and(src: string, pos: number, end: number, vars: string) -> number {
    let s = p_eq(src, pos, end, vars);
    let r = while match peek(src, s, end) { Tk::Sym(26) => true, _ => false } {
        s = advance(src, s, end);
        let s2 = p_eq(src, s, end, vars);
        emit("  pop %rcx");
        emit("  pop %rax");
        emit("  and %rcx, %rax");
        emit("  push %rax");
        s = s2
    };
    s
}

fn p_eq(src: string, pos: number, end: number, vars: string) -> number {
    let s = p_cmp(src, pos, end, vars);
    let r = while match peek(src, s, end) {
        Tk::Sym(23) => true,
        Tk::Sym(27) => true,
        _ => false
    } {
        let op = match peek(src, s, end) { Tk::Sym(23) => "sete", _ => "setne" };
        s = advance(src, s, end);
        let s2 = p_cmp(src, s, end, vars);
        emit("  pop %rcx");
        emit("  pop %rax");
        emit("  cmp %rcx, %rax");
        emit("  " + op + " %al");
        emit("  movzx %al, %rax");
        emit("  push %rax");
        s = s2
    };
    s
}

fn p_cmp(src: string, pos: number, end: number, vars: string) -> number {
    let s = p_add(src, pos, end, vars);
    let r = while match peek(src, s, end) {
        Tk::Sym(11) => true,
        Tk::Sym(13) => true,
        Tk::Sym(28) => true,
        Tk::Sym(29) => true,
        _ => false
    } {
        let op = match peek(src, s, end) {
            Tk::Sym(11) => "setl",
            Tk::Sym(13) => "setg",
            Tk::Sym(28) => "setle",
            _ => "setge"
        };
        s = advance(src, s, end);
        let s2 = p_add(src, s, end, vars);
        emit("  pop %rcx");
        emit("  pop %rax");
        emit("  cmp %rcx, %rax");
        emit("  " + op + " %al");
        emit("  movzx %al, %rax");
        emit("  push %rax");
        s = s2
    };
    s
}

fn p_add(src: string, pos: number, end: number, vars: string) -> number {
    let s = p_mul(src, pos, end, vars);
    let r = while match peek(src, s, end) {
        Tk::Sym(15) => true,
        Tk::Sym(16) => true,
        _ => false
    } {
        let op = match peek(src, s, end) { Tk::Sym(15) => "add", _ => "sub" };
        s = advance(src, s, end);
        let s2 = p_mul(src, s, end, vars);
        emit("  pop %rcx");
        emit("  pop %rax");
        emit("  " + op + " %rcx, %rax");
        emit("  push %rax");
        s = s2
    };
    s
}

fn p_mul(src: string, pos: number, end: number, vars: string) -> number {
    let s = p_unary(src, pos, end, vars);
    let r = while match peek(src, s, end) {
        Tk::Sym(17) => true,
        Tk::Sym(18) => true,
        Tk::Sym(30) => true,
        _ => false
    } {
        let k = match peek(src, s, end) {
            Tk::Sym(17) => 17,
            Tk::Sym(18) => 18,
            _ => 30
        };
        s = advance(src, s, end);
        let s2 = p_unary(src, s, end, vars);
        emit("  pop %rcx");
        emit("  pop %rax");
        if k == 17 {
            emit("  imul %rcx, %rax");
            emit("  push %rax")
        } else {
            emit("  cqto");
            emit("  idiv %rcx");
            if k == 18 { emit("  push %rax") } else { emit("  push %rdx") }
        };
        s = s2
    };
    s
}

fn p_unary(src: string, pos: number, end: number, vars: string) -> number {
    match peek(src, pos, end) {
        Tk::Sym(16) => {
            let s = advance(src, pos, end);
            let s2 = p_unary(src, s, end, vars);
            emit("  pop %rax");
            emit("  neg %rax");
            emit("  push %rax");
            s2
        },
        Tk::Sym(31) => {
            let s = advance(src, pos, end);
            let s2 = p_unary(src, s, end, vars);
            emit("  pop %rax");
            emit("  cmp $0, %rax");
            emit("  sete %al");
            emit("  movzx %al, %rax");
            emit("  push %rax");
            s2
        },
        _ => p_primary(src, pos, end, vars)
    }
}

fn p_primary(src: string, pos: number, end: number, vars: string) -> number {
    match peek(src, pos, end) {
        Tk::Num(v) => {
            emit("  push $" + to_string(v));
            advance(src, pos, end)
        },
        Tk::Id(name) => {
            let next = peek(src, advance(src, pos, end), end);
            if match next { Tk::Sym(6) => true, _ => false } {
                emit_call(src, pos, end, vars)
            } else if match next { Tk::Sym(32) => true, _ => false } {
                let s = advance(src, pos, end);
                s = advance(src, s, end);
                let ep = expr(src, s, end, vars);
                let off = var_off(vars, name);
                emit("  pop %rax");
                emit("  neg %rax");
                emit("  mov " + to_string(0 - (off + 1) * 8) + "(%rbp, %rax, 8), %rcx");
                emit("  push %rcx");
                ep
            } else {
                let off = var_off(vars, name);
                emit("  mov " + slot(off) + ", %rax");
                emit("  push %rax");
                advance(src, pos, end)
            }
        },
        Tk::Sym(6) => {
            let s = advance(src, pos, end);
            let ep = expr(src, s, end, vars);
            advance(src, ep, end)
        },
        _ => {
            emit("  push $0");
            advance(src, pos, end)
        }
    }
}

fn emit_call(src: string, pos: number, end: number, vars: string) -> number {
    let name = token_val(src, pos, end);
    let s = advance(src, pos, end);
    s = advance(src, s, end);
    let ac = 0;
    let r = while match peek(src, s, end) { Tk::Sym(7) => false, _ => true } {
        match peek(src, s, end) {
            Tk::Sym(9) => { s = advance(src, s, end) },
            _ => { s = expr(src, s, end, vars); ac = ac + 1 }
        }
    };
    let save_pop = |n: number| {
        if ac >= n { emit("  pop " + param_reg(n - 1)); 0 } else { 0 }
    };
    save_pop(4);
    save_pop(3);
    save_pop(2);
    save_pop(1);
    emit("  call " + name);
    emit("  push %rax");
    advance(src, s, end)
}

fn emit_compound(sym: number) -> number {
    if sym == 37 || sym == 38 {
        emit("  cqto");
        emit("  idiv %rcx");
        if sym == 38 { emit("  mov %rdx, %rax") } else { 0 }
    } else {
        let op = if sym == 34 { "add" } else if sym == 35 { "sub" } else if sym == 36 { "imul" } else { "idiv" };
        emit("  " + op + " %rcx, %rax")
    }
}

fn peek(src: string, pos: number, end: number) -> Tk {
    let i = skip_ws(src, pos, end);
    if i >= end {
        Tk::Eof
    } else {
        let c = str_index(src, i);
        if is_d(c) == 1 {
            let v = parse_num(src, i, end);
            Tk::Num(v.0)
        } else if is_a(c) == 1 {
            let id = parse_ident(src, i, end);
            let kw = keyword_id(id.0);
            if kw > 0 { Tk::Kw(kw) } else { Tk::Id(id.0) }
        } else {
            let s = lex_sym(src, i, end);
            Tk::Sym(s.0)
        }
    }
}

fn advance(src: string, pos: number, end: number) -> number {
    let i = skip_ws(src, pos, end);
    if i >= end {
        end
    } else {
        let c = str_index(src, i);
        if is_d(c) == 1 { parse_num(src, i, end).1 }
        else if is_a(c) == 1 { parse_ident(src, i, end).1 }
        else { lex_sym(src, i, end).1 }
    }
}

fn token_val(src: string, pos: number, end: number) -> string {
    let i = skip_ws(src, pos, end);
    let c = str_index(src, i);
    if is_d(c) == 1 { to_string(parse_num(src, i, end).0) }
    else if is_a(c) == 1 { parse_ident(src, i, end).0 }
    else { "" }
}

fn skip_ws(src: string, pos: number, end: number) -> number {
    let i = pos;
    let r = while i < end {
        let c = str_index(src, i);
        if c == 47 && i + 1 < end && str_index(src, i + 1) == 47 {
            let r2 = while i < end && str_index(src, i) != 10 { i = i + 1 }; 0
        } else if c == 47 && i + 1 < end && str_index(src, i + 1) == 42 {
            i = i + 2;
            let r2 = while i + 1 < end && (str_index(src, i) != 42 || str_index(src, i + 1) != 47) { i = i + 1 };
            i = i + 2; 0
        } else if c == 32 || c == 10 || c == 13 || c == 9 {
            i = i + 1; 0
        } else {
            break; 0
        }
    };
    i
}

fn parse_num(src: string, start: number, end: number) -> (number, number) {
    let v = 0;
    let i = start;
    let r = while i < end && is_d(str_index(src, i)) == 1 {
        v = v * 10 + (str_index(src, i) - 48);
        i = i + 1
    };
    (v, i)
}

fn parse_ident(src: string, start: number, end: number) -> (string, number) {
    let w = "";
    let i = start;
    let r = while i < end && is_an(str_index(src, i)) == 1 {
        w = w + char_to_string(str_index(src, i));
        i = i + 1
    };
    (w, i)
}

fn lex_sym(src: string, i: number, end: number) -> (number, number) {
    let c = str_index(src, i);
    let c2 = if i + 1 < end { str_index(src, i + 1) } else { 0 };
    let two = two_char(c, c2);
    if two.0 > 0 { (two.0, i + 2) } else { (single_char(c), i + 1) }
}

fn two_char(c: number, c2: number) -> (number, number) {
    if c == 61 && c2 == 61 { (23, 2) }
    else if c == 33 && c2 == 61 { (27, 2) }
    else if c == 60 && c2 == 61 { (28, 2) }
    else if c == 62 && c2 == 61 { (29, 2) }
    else if c == 38 && c2 == 38 { (26, 2) }
    else if c == 124 && c2 == 124 { (25, 2) }
    else if c == 43 && c2 == 61 { (34, 2) }
    else if c == 45 && c2 == 61 { (35, 2) }
    else if c == 42 && c2 == 61 { (36, 2) }
    else if c == 47 && c2 == 61 { (37, 2) }
    else if c == 37 && c2 == 61 { (38, 2) }
    else { (0, 0) }
}

fn single_char(c: number) -> number {
    if c == 40 { 6 }
    else if c == 41 { 7 }
    else if c == 123 { 4 }
    else if c == 125 { 8 }
    else if c == 59 { 5 }
    else if c == 44 { 9 }
    else if c == 91 { 32 }
    else if c == 93 { 33 }
    else if c == 61 { 10 }
    else if c == 60 { 11 }
    else if c == 62 { 13 }
    else if c == 33 { 31 }
    else if c == 43 { 15 }
    else if c == 45 { 16 }
    else if c == 42 { 17 }
    else if c == 47 { 18 }
    else if c == 37 { 30 }
    else { 0 }
}

fn keyword_id(w: string) -> number {
    if eq(w, "int") { 1 }
    else if eq(w, "return") { 20 }
    else if eq(w, "while") { 21 }
    else if eq(w, "if") { 19 }
    else if eq(w, "else") { 22 }
    else if eq(w, "for") { 24 }
    else { 0 }
}

fn is_d(c: number) -> number {
    if c >= 48 && c <= 57 { 1 } else { 0 }
}

fn is_a(c: number) -> number {
    if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 { 1 } else { 0 }
}

fn is_an(c: number) -> number {
    if is_a(c) == 1 { 1 } else { is_d(c) }
}

fn eq(a: string, b: string) -> bool {
    if len(a) != len(b) { false } else {
        let i = 0;
        let ok = true;
        let r = while i < len(a) && ok {
            if str_index(a, i) != str_index(b, i) { ok = false; 0 } else { 0 };
            i = i + 1
        };
        ok
    }
}

fn var_off(vm: string, name: string) -> number {
    let p = find_ch(vm, 0, 58);
    let i = 0;
    let r = while p < len(vm) {
        let nm = sub_str(vm, i, p);
        if eq(nm, name) { break; 0 } else { 0 };
        let ns = p + 1;
        let cp = find_ch(vm, ns, 44);
        i = cp + 1;
        p = find_ch(vm, i, 58)
    };
    let ns2 = p + 1;
    let sc = find_ch(vm, ns2, 59);
    let cm = find_ch(vm, ns2, 44);
    if sc < cm { pn(vm, ns2, sc) } else { pn(vm, ns2, cm) }
}

fn skip_matching(src: string, pos: number, end: number) -> number {
    let depth = 1;
    let i = pos;
    let r = while i < end && depth > 0 {
        match peek(src, i, end) {
            Tk::Sym(4) => { depth = depth + 1; 0 },
            Tk::Sym(8) => { depth = depth - 1; 0 },
            _ => 0
        };
        i = advance(src, i, end)
    };
    i
}

fn find_nth(s: string, ch: number, n: number) -> number {
    let i = 0;
    let count = 0;
    let r = while i < len(s) && count < n {
        if str_index(s, i) == ch { count = count + 1; 0 } else { 0 };
        i = i + 1
    };
    i
}

fn find_ch(s: string, start: number, ch: number) -> number {
    let i = start;
    let r = while i < len(s) {
        if str_index(s, i) == ch { break; 0 } else { 0 };
        i = i + 1
    };
    i
}

fn sub_str(s: string, a: number, b: number) -> string {
    let out = "";
    let i = a;
    let r = while i < b {
        out = out + char_to_string(str_index(s, i));
        i = i + 1
    };
    out
}

fn pn(s: string, a: number, b: number) -> number {
    if a >= b { 0 } else {
        let v = 0;
        let i = a;
        let r = while i < b {
            v = v * 10 + (str_index(s, i) - 48);
            i = i + 1
        };
         v
   }
}

fn is_kw(tk: Tk, k: number) -> bool {
   match tk {
      Tk::Kw(n) => if n == k { true } else { false },
      _ => false
   }
}
