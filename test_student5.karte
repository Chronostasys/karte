struct Student {
    name: string,
    score: number
}

fn get_grade(score: number) -> string {
    if score >= 90 {
        "A"
    } else {
        if score >= 80 {
            "B"
        } else {
            if score >= 70 {
                "C"
            } else {
                if score >= 60 {
                    "D"
                } else {
                    "F"
                }
            }
        }
    }
}

fn main() -> number {
    let s = Student { name: "Alice", score: 95 };
    let g = get_grade(s.score);
    print(s.name + ": " + g + "\n");
    0
}
