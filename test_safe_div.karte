enum Result {
    Ok(number),
    Err(number)
}

fn safe_div(a: number, b: number) -> Result {
    if b == 0 {
        Err(1)
    } else {
        Ok(a / b)
    }
}

fn main() -> number {
    let r1 = safe_div(10, 3);
    let r2 = safe_div(10, 0);
    let v1 = match r1 {
        Ok(v) => v,
        Err(e) => e * (-1)
    };
    let v2 = match r2 {
        Ok(v) => v,
        Err(e) => e * (-1)
    };
    v1 + v2
}
