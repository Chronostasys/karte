module std.hashmap

fn hm_hash(key: string) -> number {
    let n = len(key);
    let h = 5381;
    let i = 0;
    while i < n {
        h = h * 33 + str_index(key, i);
        i = i + 1;
    };
    if h < 0 { 0 - h } else { h }
}

fn hm_new(cap: number) -> number {
    let m = gc_alloc(8 + cap * 24);
    mem_store64(m, 0);
    mem_store64(m + 8, cap);
    m
}

fn hm_len(m: number) -> number {
    mem_load64(m)
}

fn hm_cap(m: number) -> number {
    mem_load64(m + 8)
}

fn hm_insert(m: number, key: string, val: string) -> number {
    let cap = mem_load64(m + 8);
    let h = hm_hash(key) % cap;
    let i = 0;
    while i < cap {
        let idx = (h + i) % cap;
        let slot = m + 8 + idx * 24;
        let used = mem_load64(slot);
        if used == 0 {
            mem_store64(slot, 1);
            mem_store64(slot + 8, key);
            mem_store64(slot + 16, val);
            let len = mem_load64(m);
            mem_store64(m, len + 1);
            i = cap;
        } else {
            let k = unsafe_cast(mem_load64(slot + 8));
            if str_equal(k, key) {
                mem_store64(slot + 16, val);
                i = cap;
            } else {
                i = i + 1;
            }
        }
    };
    m
}

fn hm_get(m: number, key: string) -> string {
    let cap = mem_load64(m + 8);
    let h = hm_hash(key) % cap;
    let i = 0;
    let result = "";
    while i < cap {
        let idx = (h + i) % cap;
        let slot = m + 8 + idx * 24;
        let used = mem_load64(slot);
        if used == 0 {
            i = cap;
        } else {
            let k = unsafe_cast(mem_load64(slot + 8));
            if str_equal(k, key) {
                result = unsafe_cast(mem_load64(slot + 16));
                i = cap;
            } else {
                i = i + 1;
            }
        }
    };
    result
}

fn hm_contains(m: number, key: string) -> number {
    let cap = mem_load64(m + 8);
    let h = hm_hash(key) % cap;
    let i = 0;
    let found = 0;
    while i < cap {
        let idx = (h + i) % cap;
        let slot = m + 8 + idx * 24;
        let used = mem_load64(slot);
        if used == 0 {
            i = cap;
        } else {
            let k = unsafe_cast(mem_load64(slot + 8));
            if str_equal(k, key) {
                found = 1;
                i = cap;
            } else {
                i = i + 1;
            }
        }
    };
    found
}

fn hm_remove(m: number, key: string) -> number {
    let cap = mem_load64(m + 8);
    let h = hm_hash(key) % cap;
    let i = 0;
    while i < cap {
        let idx = (h + i) % cap;
        let slot = m + 8 + idx * 24;
        let used = mem_load64(slot);
        if used == 0 {
            i = cap;
        } else {
            let k = unsafe_cast(mem_load64(slot + 8));
            if str_equal(k, key) {
                mem_store64(slot, 0);
                mem_store64(slot + 8, 0);
                mem_store64(slot + 16, 0);
                let len = mem_load64(m);
                mem_store64(m, len - 1);
                i = cap;
            } else {
                i = i + 1;
            }
        }
    };
    m
}
