module std.hashmap

fn hm_hash(key: string) -> number {
    let n = len(key);
    let h = 5381;
    let i = 0;
    while i < n {
        h = h * 33 + str_index(key, i);
        i = i + 1;
    };
    if h < 0 { 0 - h } else { h }
}

fn hm_new(cap: number) -> number {
    let m = gc_alloc(8 + cap * 24);
    mem_store64(m, 0);
    m
}

fn hm_len(m: number) -> number {
    mem_load64(m)
}

fn hm_insert(m: number, key: string, val: string) -> number {
    let cap = 0;
    let count = mem_load64(m);
    let cap = (count + 1) * 2;
    let new_m = gc_alloc(8 + cap * 24);
    mem_store64(new_m, 0);
    let i = 0;
    while i < count {
        let entry_base = m + 8 + i * 24;
        let old_hash = mem_load64(entry_base);
        let old_key = mem_load_ptr(entry_base + 8);
        let old_val = mem_load_ptr(entry_base + 16);
        let idx = old_hash % cap;
        let slot = new_m + 8 + idx * 24;
        let slot_used = mem_load64(slot);
        while slot_used != 0 {
            let idx = (idx + 1) % cap;
            let slot = new_m + 8 + idx * 24;
            let slot_used = mem_load64(slot);
        };
        mem_store64(slot, 1);
        mem_store64(slot + 8, old_key);
        mem_store64(slot + 16, old_val);
        let new_len = mem_load64(new_m);
        mem_store64(new_m, new_len + 1);
        i = i + 1;
    };
    let h = hm_hash(key);
    let idx = h % cap;
    let slot = new_m + 8 + idx * 24;
    let slot_used = mem_load64(slot);
    while slot_used != 0 {
        let k = mem_load_ptr(slot + 8);
        if str_equal(k, key) {
            mem_store64(slot + 16, val);
            let slot_used = 0;
        } else {
            let idx = (idx + 1) % cap;
            let slot = new_m + 8 + idx * 24;
            let slot_used = mem_load64(slot);
        }
    };
    mem_store64(slot, 1);
    mem_store64(slot + 8, key);
    mem_store64(slot + 16, val);
    let new_len = mem_load64(new_m);
    mem_store64(new_m, new_len + 1);
    new_m
}

fn hm_get(m: number, key: string) -> string {
    let count = mem_load64(m);
    let i = 0;
    let result = "";
    while i < count {
        let entry_base = m + 8 + i * 24;
        let k = mem_load_ptr(entry_base + 8);
        if str_equal(k, key) {
            let result = mem_load_ptr(entry_base + 16);
            let i = count;
            result
        } else {
            let i = i + 1;
        }
    };
    result
}

fn hm_contains(m: number, key: string) -> number {
    let count = mem_load64(m);
    let i = 0;
    let found = 0;
    while i < count {
        let entry_base = m + 8 + i * 24;
        let k = mem_load_ptr(entry_base + 8);
        if str_equal(k, key) {
            let found = 1;
            let i = count;
        } else {
            let i = i + 1;
        }
    };
    found
}
