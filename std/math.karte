module std.math

fn even(n: number) -> number {
    if n % 2 == 0 { 1 } else { 0 }
}

fn odd(n: number) -> number {
    if n % 2 != 0 { 1 } else { 0 }
}

fn square(n: number) -> number {
    n * n
}

fn cube(n: number) -> number {
    n * n * n
}

fn sqrt_floor(n: number) -> number {
    if n <= 0 {
        0
    } else {
        let lo = 1;
        let hi = n;
        let result = 0;
        while lo <= hi {
            let mid = (lo + hi) / 2;
            let sq = mid * mid;
            if sq == n {
                result = mid;
                lo = hi + 1
            } else {
                if sq < n {
                    result = mid;
                    lo = mid + 1
                } else {
                    hi = mid - 1
                }
            }
        };
        result
    }
}

fn is_prime(n: number) -> number {
    if n < 2 {
        0
    } else {
        if n == 2 {
            1
        } else {
            if n % 2 == 0 {
                0
            } else {
                let i = 3;
                let result = 1;
                while i * i <= n {
                    if n % i == 0 {
                        result = 0;
                        i = n
                    } else {
                        i = i + 2
                    }
                };
                result
            }
        }
    }
}

fn count_primes(n: number) -> number {
    let count = 0;
    let i = 2;
    while i <= n {
        if is_prime(i) != 0 {
            count = count + 1
        };
        i = i + 1
    };
    count
}

fn sum_primes(n: number) -> number {
    let sum = 0;
    let i = 2;
    while i <= n {
        if is_prime(i) != 0 {
            sum = sum + i
        };
        i = i + 1
    };
    sum
}

fn nth_prime(n: number) -> number {
    if n <= 0 {
        0
    } else {
        let count = 0;
        let candidate = 2;
        while count < n {
            if is_prime(candidate) != 0 {
                count = count + 1
            };
            if count < n {
                candidate = candidate + 1
            }
        };
        candidate
    }
}

fn divisors(n: number) -> number {
    if n <= 0 {
        0
    } else {
        let count = 0;
        let i = 1;
        while i * i <= n {
            if n % i == 0 {
                count = count + 1;
                if i != n / i {
                    count = count + 1
                }
            };
            i = i + 1
        };
        count
    }
}

fn sum_divisors(n: number) -> number {
    if n <= 0 {
        0
    } else {
        let sum = 0;
        let i = 1;
        while i * i <= n {
            if n % i == 0 {
                sum = sum + i;
                if i != n / i {
                    sum = sum + n / i
                }
            };
            i = i + 1
        };
        sum
    }
}

fn sum_proper_divisors(n: number) -> number {
    sum_divisors(n) - n
}

fn is_perfect(n: number) -> number {
    if n <= 1 {
        0
    } else {
        if sum_proper_divisors(n) == n {
            1
        } else {
            0
        }
    }
}

fn binomial(n: number, k: number) -> number {
    if k > n {
        0
    } else {
        if k == 0 {
            1
        } else {
            if k == n {
                1
            } else {
                let numerator = 1;
                let i = 0;
                while i < k {
                    numerator = numerator * (n - i);
                    i = i + 1
                };
                let denominator = 1;
                let j = 1;
                while j <= k {
                    denominator = denominator * j;
                    j = j + 1
                };
                numerator / denominator
            }
        }
    }
}

fn triangular(n: number) -> number {
    n * (n + 1) / 2
}

fn digit_sum(n: number) -> number {
    let x = n;
    let sum = 0;
    while x > 0 {
        sum = sum + x % 10;
        x = x / 10
    };
    sum
}

fn reverse_digits(n: number) -> number {
    let x = n;
    let rev = 0;
    while x > 0 {
        rev = rev * 10 + x % 10;
        x = x / 10
    };
    rev
}

fn is_palindrome(n: number) -> number {
    if n == reverse_digits(n) {
        1
    } else {
        0
    }
}

fn count_digits(n: number) -> number {
    if n == 0 {
        1
    } else {
        let x = n;
        let count = 0;
        while x > 0 {
            count = count + 1;
            x = x / 10
        };
        count
    }
}
