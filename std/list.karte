module std.list

fn range(start: number, end: number) -> number {
    start
}

fn sum_range(start: number, end: number) -> number {
    let s = 0;
    let i = start;
    while i <= end {
        s = s + i;
        i = i + 1
    };
    s
}

fn sum_squares(start: number, end: number) -> number {
    let s = 0;
    let i = start;
    while i <= end {
        s = s + i * i;
        i = i + 1
    };
    s
}

fn sum_multiples_of(n: number, limit: number) -> number {
    let s = 0;
    let i = n;
    while i < limit {
        s = s + i;
        i = i + n
    };
    s
}

fn sum_of_evens(start: number, end: number) -> number {
    let s = 0;
    let i = start;
    while i <= end {
        if i % 2 == 0 {
            s = s + i
        };
        i = i + 1
    };
    s
}

fn sum_of_odds(start: number, end: number) -> number {
    let s = 0;
    let i = start;
    while i <= end {
        if i % 2 != 0 {
            s = s + i
        };
        i = i + 1
    };
    s
}

fn count_multiples(n: number, limit: number) -> number {
    (limit - 1) / n
}

fn collatz_steps(n: number) -> number {
    let x = n;
    let steps = 0;
    while x != 1 {
        if x % 2 == 0 {
            x = x / 2
        } else {
            x = 3 * x + 1
        };
        steps = steps + 1
    };
    steps
}

fn max_collatz(start: number, end: number) -> number {
    let max_n = 0;
    let max_steps = 0;
    let i = start;
    while i <= end {
        let steps = collatz_steps(i);
        if steps > max_steps {
            max_steps = steps;
            max_n = i
        };
        i = i + 1
    };
    max_n
}
