module std.string

fn length(s: string) -> number {
    len(s)
}

fn concat(a: string, b: string) -> string {
    a + b
}

fn contains(s: string, ch: number) -> number {
    str_contains(s, ch)
}

fn count_splits(s: string, delimiter: number) -> number {
    split_count(s, delimiter)
}

fn char_code(s: string, index: number) -> number {
    str_index(s, index)
}

fn from_number(n: number) -> string {
    to_string(n)
}

fn is_empty(s: string) -> bool {
    len(s) == 0
}

fn starts_with(s: string, ch: number) -> bool {
    if len(s) > 0 {
        str_index(s, 0) == ch
    } else {
        false
    }
}

fn ends_with(s: string, ch: number) -> bool {
    let n = len(s);
    if n > 0 {
        str_index(s, n - 1) == ch
    } else {
        false
    }
}

fn repeat(s: string, count: number) -> string {
    let result = "";
    let i = 0;
    while i < count {
        result = result + s;
        i += 1
    };
    result
}

fn index_of(s: string, ch: number) -> number {
    let n = len(s);
    let i = 0;
    while i < n {
        if str_index(s, i) == ch {
            return i
        };
        i += 1
    };
    -1
}

fn last_index_of(s: string, ch: number) -> number {
    let i = len(s) - 1;
    while i >= 0 {
        if str_index(s, i) == ch {
            return i
        };
        i -= 1
    };
    -1
}

fn to_upper_char(ch: number) -> number {
    if ch >= 97 && ch <= 122 {
        ch - 32
    } else {
        ch
    }
}

fn to_lower_char(ch: number) -> number {
    if ch >= 65 && ch <= 90 {
        ch + 32
    } else {
        ch
    }
}

fn to_upper(s: string) -> string {
    let n = len(s);
    let result = "";
    let i = 0;
    while i < n {
        let ch = str_index(s, i);
        result = result + char_to_string(to_upper_char(ch));
        i += 1
    };
    result
}

fn to_lower(s: string) -> string {
    let n = len(s);
    let result = "";
    let i = 0;
    while i < n {
        let ch = str_index(s, i);
        result = result + char_to_string(to_lower_char(ch));
        i += 1
    };
    result
}

fn reverse(s: string) -> string {
    let n = len(s);
    let result = "";
    let i = n - 1;
    while i >= 0 {
        result = result + char_to_string(str_index(s, i));
        i -= 1
    };
    result
}

fn trim(s: string) -> string {
    let n = len(s);
    let start = 0;
    let end = n - 1;
    while start < n {
        let c = str_index(s, start);
        if c == 32 || c == 9 || c == 10 || c == 13 {
            start += 1
        } else {
            break
        }
    };
    while end >= start {
        let c = str_index(s, end);
        if c == 32 || c == 9 || c == 10 || c == 13 {
            end -= 1
        } else {
            break
        }
    };
    substring(s, start, end + 1)
}
