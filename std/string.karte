module std.string

fn length(s: string) -> number {
    len(s)
}

fn concat(a: string, b: string) -> string {
    a + b
}

fn char_code(s: string, index: number) -> number {
    str_index(s, index)
}

fn from_number(n: number) -> string {
    to_string(n)
}

fn is_empty(s: string) -> bool {
    len(s) == 0
}

fn starts_with(s: string, ch: number) -> bool {
    if len(s) > 0 {
        str_index(s, 0) == ch
    } else {
        false
    }
}

fn ends_with(s: string, ch: number) -> bool {
    let n = len(s);
    if n > 0 {
        str_index(s, n - 1) == ch
    } else {
        false
    }
}

fn repeat(s: string, count: number) -> string {
    let result = "";
    let i = 0;
    while i < count {
        result = result + s;
        i += 1
    };
    result
}

fn substring(s: string, start: number, length: number) -> string {
    let result = "";
    let i = 0;
    while i < length {
        let ch = str_index(s, start + i);
        result = result + char_to_string(ch);
        i += 1
    };
    result
}

fn contains(s: string, ch: number) -> number {
    let n = len(s);
    let i = 0;
    let found = 0;
    while i < n {
        if str_index(s, i) == ch {
            found = 1
        };
        i += 1
    };
    found
}

fn count_splits(s: string, delimiter: number) -> number {
    let n = len(s);
    let count = 1;
    let i = 0;
    while i < n {
        if str_index(s, i) == delimiter {
            count += 1
        };
        i += 1
    };
    count
}
