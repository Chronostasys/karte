struct Pair {
    first: number,
    second: number
}

fn make_pair(a: number, b: number) -> Pair {
    Pair { first: a, second: b }
}

fn get_first(p: Pair) -> number {
    p.first
}

fn get_second(p: Pair) -> number {
    p.second
}

fn main() -> number {
    let p = make_pair(10, 20);
    get_first(p) + get_second(p)
}
